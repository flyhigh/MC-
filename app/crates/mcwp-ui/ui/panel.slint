// MC 壁纸 · 控制面板 —— 生图界面(iOS 26 液态玻璃风格)
//
// 信息架构是两块,顶上再压一条窗口自己的「安全区」(自定义标题栏,见下面「顶部安全区」一段):
//
//   ┌───────────────────────────────────────────────────────────┐
//   │ ● MC 壁纸 · 生图                            −      □      × │
//   ├──────────────┬────────────────────────────────────────────┤
//   │ 历史对话      │ 会话标题                                    │
//   │  + 新建对话   │ ──────────────────────────────────────────  │
//   │  对话一 ·…    │ 消息流(用户的靠右、染色;回复靠左、薄填充)  │
//   │  对话二 ·…    │                                             │
//   │  …            │ ──────────────────────────────────────────  │
//   │  壁纸参数     │ [ 说一句想看到的样子…         ] [ 发送 ]    │
//   │  壁纸库       │                                             │
//   │  设置         │                                             │
//   └──────────────┴────────────────────────────────────────────┘
//
// 左栏是会话历史常驻的位置,底部三项把右栏换成参数 / 库 / 设置 —— 原来「壁纸 / 库 / 设置」
// 三个页签的内容没丢,只是从顶部挪到了左栏底部,顶上那一行留给会话标题。`view` 是纯界面状态
// (0 会话 / 1 参数 / 2 库 / 3 设置),不进 Rust;切视图一律用 `if` 而不是 `visible`。
//
// 壁纸库页的列表不写死在面板里:壁纸侧扫过 `%APPDATA%\MC壁纸\library` 再整块灌进来
// (`library` / `library-current`),切到库页时回调 `refresh-library` 要一份最新的 ——
// 库目录是用户可写的地方,面板自己不去读文件。
//
// —— 视觉与软件渲染器的能力边界(踩过才知道,别重犯)——
//   * 支持:线性/径向渐变、圆角、alpha 混合、旋转、颜色插值动画
//   * 不支持:backdrop-blur、盒阴影(draw_box_shadow 是 TODO)、裁剪路径、渐变描边
//     → 阴影用「径向渐变暗斑」伪造,描边一律实色
//   * **圆角只对实色背景生效**。software_renderer.rs 的 `process_rectangle_impl` 里,渐变是
//     单独一条分支:它把整个矩形直接刷下去(不看 radius),随后那次 `process_rounded_rectangle`
//     拿到的 inner_color 是透明的,等于什么也没画。表现就是「发丝线描边是圆的、填充是直角」。
//     → 凡是要圆角的地方一律用实色(带 alpha 的实色也算);渐变只留给圆角不重要的地方
//       (窗口底色、环境光斑)。
//   * `visible: false` 会被降级成一个 Clip 包裹元素,照样占布局空间;要不占位就用 `if`。
//   * **Window 的孩子不带 `x` / `y` 时会被居中摆**,不是左上角。满窗口的底色看不出来,
//     一条 36px 的标题栏会直接跑到正中间 —— 贴边的元素一律显式写 `x: 0px; y: 0px;`。
//   * 布局的 `alignment` 指的是**主轴**方向:HorizontalLayout 里写 `alignment: center` 会把整条
//     内容挤到中间(横向 stretch 同时也失效,输入框会塌成文字那么宽)。横向布局一律不写它,
//     竖直居中交给布局默认的 cross 居中;真要竖排居中就用 VerticalLayout 的 alignment: center。
//     反过来也要注意:HBox 里**定宽高**的孩子(圆点、色卡、胶囊按钮)没有"竖直居中"可言,
//     它们会被摆在这一行的顶边 —— 要居中就套一层 `VerticalLayout { alignment: center; }`。
//
// 玻璃的三条原则(Apple HIG「Materials / Liquid Glass」+ WWDC25 §219):
//   1. 玻璃是功能层,浮在内容层之上:先铺环境底,玻璃盖上去;玻璃内部不再叠玻璃,
//      只用薄填充 / 白色高光 / 发丝线。
//   2. 软件渲染器没有真·背景模糊,「折射」靠半透明 + 顶部高光 + 底部内缘暗线模拟。
//   3. 玻璃铺满整个窗口,圆角跟 DWM 画的那圈对齐,卡片再用更小的圆角嵌在里面。
//
// 字重约定:动态文案(会话名、消息、输入框里的字)一律用 regular —— 内嵌的 regular 是
// 全字集(GB2312 一级字,见 tools/subset-panel-font.py),bold 只收了面板自己的静态文案,
// 拿 bold 画用户输入的字会静默缺字。标题的层级感靠字号/颜色,不靠字重。
//
// 与 Rust 的唯一接口还是下面这些 property / callback,面板自己不持有任何持久状态:
// 会话列表与消息也是 Rust 传进来的模型,面板只负责画。

// 把子集字体编进 exe。Slint 认 `import "xxx.ttf"` 这种写法:build.rs 的 EmbedFiles 会把
// 字体数据塞进二进制,生成的初始化代码再调 register_font_from_memory() 注册族名。
// 名字必须和下面的 default-font-family 对上,否则回落到系统字体(CJK 会整片画不出来)。
// 字体是子集化的:改了面板文案要重跑 tools/subset-panel-font.py。
import "../fonts/panel-cjk-regular.ttf";
import "../fonts/panel-cjk-bold.ttf";

// 设计令牌。深色玻璃 + iOS 系统色。
global Glass {
    out property <color> label: #FFFFFFFF;
    out property <color> label-2: #EBEBF59E;
    out property <color> label-3: #EBEBF55C;
    out property <color> hairline: #FFFFFF24;
    out property <color> hairline-dim: #FFFFFF14;
    out property <color> specular: #FFFFFF8A;
    out property <color> fill: #FFFFFF14;
    out property <color> fill-strong: #FFFFFF1F;
    out property <color> fill-hover: #FFFFFF2E;
    out property <color> rim-dark: #0000007A;

    // 窗口那一圈圆角由 DWM 画(DWMWCP_ROUND,约 8px),我们画的每一层都跟它对齐 ——
    // 自己画大一点,窗口里就会露出一小块背景色拼成的"墙角"。
    out property <length> r-window: 8px;
    out property <length> r-card: 12px;
}

// 参数视图里的一张预设卡片(原来是"壁纸"页的主内容)。
export struct PresetItem {
    id: string,
    title: string,
    summary: string,
    label-a: string,
    label-b: string,
    label-c: string,
    value-a: float,
    value-b: float,
    value-c: float,
    motion: float,
}

// 一条消息。`mine` = 用户自己发的那条。
export struct ChatMessage {
    mine: bool,
    text: string,
}

// 左栏里的一条历史对话。
export struct ConversationItem {
    heading: string,
    sub: string,
    // 置顶的排在列表最前面(排序在壁纸侧做,面板只画)
    pinned: bool,
    // 有未读消息:行尾挂一个染色小圆点,切进这个会话就清掉
    unread: bool,
}

// 壁纸库里的一张壁纸(壁纸侧扫描库目录得到)。`accent` 是它调色板里的主色,卡片靠它区分;
// 真缩略图要拿 spec 渲染一张才准,那是后面的事,先不假装有。
export struct LibraryItem {
    id: string,
    title: string,
    hint: string,
    summary: string,
    accent: color,
}
// 玻璃上的「胶囊」按钮。主操作是 tinted(染色玻璃),次操作是普通玻璃。
component Pill inherits Rectangle {
    in property <string> text: "";
    in property <bool> primary: false;
    in property <color> accent: #0A84FF;

    callback clicked();

    height: 34px;
    width: 104px;
    border-radius: self.height / 2;
    border-width: 1px;
    border-color: primary ? accent.with-alpha(0.55) : Glass.hairline;
    background: primary
        ? (touch.has-hover ? accent.brighter(0.12) : accent)
        : (touch.pressed ? Glass.fill-strong : (touch.has-hover ? Glass.fill-hover : Glass.fill));
    animate background { duration: 140ms; easing: ease-out; }

    // 顶部高光:一条横向渐变的细线,让胶囊有玻璃厚度
    Rectangle {
        x: parent.width * 0.12;
        y: 0.5px;
        width: parent.width * 0.76;
        height: 1px;
        border-radius: 0.5px;
        background: @linear-gradient(90deg, #FFFFFF00 0%, Glass.specular 50%, #FFFFFF00 100%);
        opacity: primary ? 0.5 : 0.8;
    }

    t := Text {
        text: root.text;
        color: Glass.label;
        font-size: 13px;
        font-weight: root.primary ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// iOS 风格滑杆:粗胶囊轨道 + 白色圆钮。
component GlassSlider inherits VerticalLayout {
    in property <string> label: "";
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <color> accent: #0A84FF;
    in-out property <float> value: 0.5;

    spacing: 7px;
    height: 52px;

    HorizontalLayout {
        height: 15px;
        Text {
            text: root.label;
            color: Glass.label-2;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: "\{round((root.value - root.minimum) / (root.maximum - root.minimum) * 100)}%";
            color: Glass.label-3;
            font-size: 12px;
            vertical-alignment: center;
        }
    }

    track := Rectangle {
        height: 30px;
        border-radius: 15px;
        // 凹槽:实色压暗 + 内缘暗线,读起来像被"挖"进玻璃里。
        background: #0000003D;
        border-width: 1px;
        border-color: Glass.hairline-dim;

        // 已填充部分:染色玻璃
        Rectangle {
            x: 1px;
            y: 1px;
            width: max(0px, min(parent.width - 2px, knob.x + knob.width / 2 - 1px));
            height: parent.height - 2px;
            border-radius: (parent.height - 2px) / 2;
            background: accent.brighter(0.10);
            opacity: 0.92;
        }

        knob := Rectangle {
            width: 24px;
            height: 24px;
            y: (parent.height - self.height) / 2;
            x: clamp((parent.width - self.width) * (root.value - root.minimum) / (root.maximum - root.minimum), 0px, parent.width - self.width);
            border-radius: self.width / 2;
            background: #FFFFFF;
            border-width: 1px;
            border-color: #FFFFFFE6;
            animate x { duration: 120ms; easing: ease-out; }
        }

        touch := TouchArea {
            mouse-cursor: pointer;
            pointer-event(e) => {
                // `move` 事件是"悬停也会来"的:不加 `touch.pressed` 这道闸,鼠标只是从滑杆上
                // 划过就会改值 —— 面板上几个滑杆会被一次挥动全部带动。
                if (e.kind == PointerEventKind.down
                    || (e.kind == PointerEventKind.move && touch.pressed)) {
                    root.value = root.minimum + clamp((touch.mouse-x - knob.width / 2) / (track.width - knob.width), 0, 1) * (root.maximum - root.minimum);
                }
            }
            clicked => {
                root.value = root.minimum + clamp((touch.mouse-x - knob.width / 2) / (track.width - knob.width), 0, 1) * (root.maximum - root.minimum);
            }
        }
    }
}
// 参数视图里的预设卡片。选中的用染色玻璃表示,未选中的是薄填充。
component PresetRow inherits Rectangle {
    in property <bool> selected: false;
    in property <string> heading: "";
    in property <string> sub: "";
    in property <color> accent: #0A84FF;

    callback picked();

    height: 58px;
    border-radius: Glass.r-card;
    border-width: 1px;
    border-color: selected ? accent.with-alpha(0.5) : Glass.hairline-dim;
    background: selected
        ? accent.with-alpha(touch.has-hover ? 0.2 : 0.16)
        : (touch.has-hover ? Glass.fill-hover : Glass.fill);
    animate background { duration: 160ms; easing: ease-out; }
    animate border-color { duration: 160ms; easing: ease-out; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        // 不写 alignment:横向布局的它是主轴方向,会把内容挤到中间(见文件顶部)

        // 选中指示器:一颗小圆点(套 VBox 才能在行内竖直居中,见文件顶部的布局说明)
        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 7px;
                height: 7px;
                border-radius: 3.5px;
                background: selected ? accent : Glass.label-3;
                opacity: selected ? 1 : 0.35;
                animate opacity { duration: 160ms; }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;

            Text {
                text: root.heading;
                color: selected ? Glass.label : Glass.label-2;
                font-size: 14px;
                font-weight: selected ? 600 : 400;
                animate color { duration: 160ms; }
            }
            Text {
                text: root.sub;
                color: Glass.label-3;
                font-size: 11px;
                wrap: word-wrap;
                max-height: 14px;
                overflow: elide;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
}

// 左栏:一条历史对话。
component ConversationRow inherits Rectangle {
    in property <string> heading: "";
    in property <string> sub: "";
    in property <bool> selected: false;
    in property <bool> pinned: false;
    in property <bool> unread: false;
    // 正在改名:两行文案让位给一个输入框(见下面那段 `if renaming`)
    in property <bool> renaming: false;
    in property <color> accent: #0A84FF;

    // 改名的草稿。只有这一行自己用:面板不存它,回车那一刻才连名字一起交上去,
    // 所以「点了别处」= 草稿丢掉(改名没提交),和 Esc 一个效果。
    private property <string> draft: "";

    // 进改名状态时把草稿重置成当前名字。**不能只靠输入框的 `init`**:行元素会被 slint 复用
    // (列表增删 / 置顶重排都只是换绑模型项),复用到的元素不会再跑一遍 `init`,`draft` 就会
    // 留着上一次 —— 甚至是别的会话 —— 的名字,回车一敲就把别人的名字盖过来了。
    changed renaming => {
        if (root.renaming) {
            root.draft = root.heading;
        }
    }

    callback picked();
    // 右键:告诉我点在**窗口里的**哪个位置(逻辑像素)—— 菜单弹在那儿,所以本行自己把
    // 行内坐标加上 `absolute-position` 再报上去
    callback menu-requested(length, length);
    callback rename-committed(string);
    callback rename-cancelled();

    height: 50px;
    border-radius: Glass.r-card;
    // 未选中时不画描边(透明描边 + 实色填充,圆角才生效)
    border-width: 1px;
    border-color: selected ? accent.with-alpha(0.5) : #FFFFFF00;
    background: selected
        ? accent.with-alpha(touch.has-hover ? 0.22 : 0.16)
        : (touch.has-hover ? Glass.fill-hover : #FFFFFF00);
    animate background { duration: 160ms; easing: ease-out; }

    // 选中指示条:贴在左内缘的一小截染蓝竖条
    Rectangle {
        x: 1px;
        y: 10px;
        width: 2px;
        height: parent.height - 20px;
        border-radius: 1px;
        background: root.selected ? root.accent : #FFFFFF00;
    }

    VerticalLayout {
        padding-left: 14px;
        // 右边给行尾那两个状态标(置顶 / 未读)留位,别让标题压到它们下面
        padding-right: 34px;
        alignment: center;
        spacing: 2px;

        Text {
            text: root.heading;
            visible: !root.renaming;
            color: root.selected ? Glass.label : Glass.label-2;
            font-size: 13px;
            overflow: elide;
            animate color { duration: 160ms; }
        }
        Text {
            text: root.sub;
            visible: !root.renaming;
            color: Glass.label-3;
            font-size: 11px;
            overflow: elide;
        }
    }

    // —— 行尾的状态标:置顶一根小图钉、未读一个染色圆点 ——
    // 图形一律自己画:内嵌子集只收面板文案用得上的字形,图钉这种符号没有。
    if root.pinned : Rectangle {
        x: parent.width - 30px;
        y: (parent.height - 12px) / 2;
        width: 8px;
        height: 12px;

        Rectangle {
            x: 0px;
            y: 0px;
            width: 8px;
            height: 2px;
            border-radius: 1px;
            background: Glass.label-3;
        }
        Rectangle {
            x: 3px;
            y: 3px;
            width: 2px;
            height: 9px;
            background: Glass.label-3;
        }
    }
    if root.unread : Rectangle {
        x: parent.width - 16px;
        y: (parent.height - 7px) / 2;
        width: 7px;
        height: 7px;
        border-radius: 3.5px;
        background: root.accent;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
        pointer-event(e) => {
            // 右键:菜单弹在点下去的地方(左键那条走 clicked,见文件头关于按钮的说明)。
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                root.menu-requested(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y,
                );
            }
        }
    }

    // 改名时的输入框。**放在 `touch` 后面** = 浮在整行之上(和标题栏那三颗窗口键同一个
    // 道理:后声明的先拿事件),敲字、全选、点回来接着改都轮不到下面那颗 TouchArea。
    if root.renaming : Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        border-radius: Glass.r-card;
        background: #00000052;
        border-width: 1px;
        border-color: root.accent.with-alpha(0.65);

        rename-input := TextInput {
            x: 13px;
            y: (parent.height - self.height) / 2;
            width: parent.width - 26px;
            height: 20px;
            font-size: 13px;
            color: Glass.label;
            vertical-alignment: center;
            text <=> root.draft;

            // 建出来就把当前名字填上、聚焦、全选:改名的下一步就是敲字,不该让人再点一次
            init => {
                self.text = root.heading;
                self.focus();
                self.select-all();
            }

            accepted => { root.rename-committed(self.text); }
            key-pressed(e) => {
                // Esc 撤掉这次改名(和系统里改名的习惯一致);其余按键照常交给输入框
                if (e.text == "\u{1b}") {
                    root.rename-cancelled();
                    return accept;
                }
                return reject;
            }
        }
    }
}

// 会话右键菜单里的一行。危险操作(删除)用 `danger` 标出来:悬停整行染红。
//
// 菜单里不放图标:内嵌子集里没有铅笔 / 图钉这类符号,画 12px 的几何图形又太像涂鸦,
// 干脆只用文字 —— 也省得为了菜单再塞一套图片资源进来。
component MenuRow inherits Rectangle {
    in property <string> text: "";
    in property <bool> danger: false;

    callback picked();

    height: 30px;
    border-radius: 6px;
    background: touch.has-hover ? (danger ? #C42B1C38 : Glass.fill-hover) : #00000000;
    animate background { duration: 120ms; easing: ease-out; }

    Text {
        x: 12px;
        y: 0px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.text;
        color: root.danger
            ? (touch.has-hover ? #FFFFFFFF : Glass.label-2)
            : (touch.has-hover ? Glass.label : Glass.label-2);
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
        animate color { duration: 120ms; easing: ease-out; }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
}

// 一条会话的右键菜单:重命名 / 置顶 / 标记为未读 / 删除。
//
// 尺寸(176 × 143)在面板那侧也写着一份(`menu-w` / `menu-h`):菜单得知道自己多大才能
// 贴着窗口边收住,而布局撑出来的高度面板读不到。改行数 / 行高记得两边一起改。
component ConversationMenu inherits Rectangle {
    in property <bool> pinned: false;
    // 菜单底色。由面板传 `caption-plate`(和顶部安全区同一族色),菜单才不会像块外来的板子。
    in property <color> plate: #161B28;

    callback rename-picked();
    callback pin-picked();
    callback unread-picked();
    callback delete-picked();

    width: 176px;
    height: 143px;
    border-radius: 10px;
    // 实色(不是玻璃):菜单要压住底下的内容读字,不该透出会话行
    background: plate;
    border-width: 1px;
    border-color: Glass.hairline;

    VerticalLayout {
        x: 6px;
        y: 6px;
        width: parent.width - 12px;
        height: parent.height - 12px;
        spacing: 0px;

        MenuRow { text: "重命名"; picked => { root.rename-picked(); } }
        MenuRow {
            text: root.pinned ? "取消置顶" : "置顶";
            picked => { root.pin-picked(); }
        }
        MenuRow { text: "标记为未读"; picked => { root.unread-picked(); } }

        // 分隔线:前后各留 5px,和系统菜单里那条一样,把「删除」隔出去
        Rectangle {
            height: 11px;

            Rectangle {
                x: 6px;
                y: 5px;
                width: parent.width - 12px;
                height: 1px;
                background: Glass.hairline-dim;
            }
        }

        MenuRow { text: "删除对话"; danger: true; picked => { root.delete-picked(); } }
    }
}

// 壁纸库里的一张壁纸:左边一块主色色卡(缩略图的占位),右边标题 + 关键词,尾巴上挂指纹。
component LibraryRow inherits Rectangle {
    in property <string> heading: "";
    in property <string> sub: "";
    in property <string> meta: "";
    in property <color> accent: #0A84FF;
    in property <bool> selected: false;

    callback picked();

    height: 54px;
    border-radius: Glass.r-card;
    // 未选中时不画描边(透明描边 + 实色填充,圆角才生效)
    border-width: 1px;
    border-color: selected ? accent.with-alpha(0.5) : #FFFFFF00;
    background: selected
        ? accent.with-alpha(touch.has-hover ? 0.22 : 0.16)
        : (touch.has-hover ? Glass.fill-hover : #FFFFFF00);
    animate background { duration: 160ms; easing: ease-out; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;

        // 这里不要写 alignment:横向布局的 alignment 是主轴(水平)方向,写了会把整条内容
        // 挤到中间去(和左栏 NavRow 是同一个坑);竖直居中交给布局默认的 cross 居中。

        // 色卡:这张壁纸自己的主色(实色才有圆角,渐变画不出圆角)。
        // 套 VBox 是为了在 54px 的行里竖直居中,见文件顶部的布局说明。
        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 10px;
                background: root.accent;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            Text {
                text: root.heading;
                color: root.selected ? Glass.label : Glass.label-2;
                font-size: 13px;
                overflow: elide;
            }
            Text {
                text: root.sub;
                color: Glass.label-3;
                font-size: 11px;
                overflow: elide;
            }
        }

        Text {
            text: root.meta;
            color: Glass.label-3;
            font-size: 10px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
}

// 左栏底部:切到「壁纸参数 / 壁纸库 / 设置」。再点一次回到会话。
component NavRow inherits Rectangle {
    in property <string> text: "";
    in property <bool> active: false;
    in property <color> accent: #0A84FF;

    callback picked();

    height: 32px;
    border-radius: 8px;
    background: active
        ? accent.with-alpha(0.18)
        : (touch.has-hover ? Glass.fill-hover : #FFFFFF00);
    animate background { duration: 140ms; easing: ease-out; }

    HorizontalLayout {
        padding-left: 11px;
        spacing: 9px;

        // 套一层 VBox:横向布局里定高的圆点会被顶到行顶边,竖直居中得靠 VBox 的主轴居中
        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: active ? accent : Glass.label-3;
                opacity: active ? 1 : 0.45;
            }
        }
        Text {
            text: root.text;
            color: active ? Glass.label : Glass.label-2;
            font-size: 12px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
}

// 顶部安全区右边的一颗窗口键:最小化 / 放大 / 还原 / 关闭。
//
// 图形一律自己画(横线、方框):内嵌子集只收了面板文案用得到的字形,「最小化」「还原」
// 这类符号有没有全看运气。关闭那颗是例外 —— × 在子集里(原来的关闭圆钮用的就是它)。
// 尺寸照 Windows 的惯例:46px 宽、满高、只填充不描边,关闭键悬停变红。
component CaptionButton inherits Rectangle {
    in property <int> kind: 1;             // 0 最小化 / 1 放大 / 2 还原 / 3 关闭
    in property <color> plate: #0B0F19;    // 标题栏底色(「还原」那块要拿它遮掉后面一格)

    callback picked();

    width: 46px;
    height: 100%;
    background: touch.has-hover ? (kind == 3 ? #C42B1C : Glass.fill-hover) : #00000000;
    animate background { duration: 120ms; }

    if kind == 3 : Text {
        width: 100%;
        height: 100%;
        text: "×";
        color: touch.has-hover ? #FFFFFFFF : Glass.label-2;
        font-size: 16px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // 最小化:一条横线
    if kind == 0 : Rectangle {
        width: 10px;
        height: 1px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Glass.label-2;
    }

    // 放大:一个方框
    if kind == 1 : Rectangle {
        width: 10px;
        height: 10px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-width: 1px;
        border-color: Glass.label-2;
    }

    // 还原:两个错开的方框,前面那格用标题栏底色盖掉后面那格的右下角
    if kind == 2 : Rectangle {
        width: 9px;
        height: 9px;
        x: (parent.width - self.width) / 2 + 2px;
        y: (parent.height - self.height) / 2 - 2px;
        border-width: 1px;
        border-color: Glass.label-2;
    }
    if kind == 2 : Rectangle {
        width: 9px;
        height: 9px;
        x: (parent.width - self.width) / 2 - 2px;
        y: (parent.height - self.height) / 2 + 2px;
        border-width: 1px;
        border-color: Glass.label-2;
        background: plate;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
}

// 右栏:一条消息。用户的气泡靠右、染色;回复靠左、薄填充。
component MessageRow inherits HorizontalLayout {
    in property <string> body: "";
    in property <bool> mine: false;
    in property <color> accent: #0A84FF;

    // 靠边:用户消息靠右、回复靠左(伸缩项吃掉剩余空间),两侧各留 6px 给圆角喘口气
    padding-left: 6px;
    padding-right: 6px;
    if mine : Rectangle { horizontal-stretch: 1; }
    if !mine : Rectangle { horizontal-stretch: 1; }

    bubble := Rectangle {
        // 贴着内容大小,不被行高拉伸
        vertical-stretch: 0;
        horizontal-stretch: 0;
        min-width: 56px;
        max-width: 440px;
        border-radius: 14px;
        border-width: 1px;
        border-color: mine ? accent.with-alpha(0.45) : Glass.hairline-dim;
        // 实色(带 alpha 的实色也算),圆角才生效
        background: mine ? accent.with-alpha(0.26) : Glass.fill;

        VerticalLayout {
            padding: 10px;
            Text {
                text: root.body;
                wrap: word-wrap;
                color: Glass.label;
                font-size: 13px;
            }
        }
    }
}
export component Panel inherits Window {
    // —— 会话视图:左栏历史 + 右栏消息 ——
    in property <[ConversationItem]> conversations;
    in-out property <int> current-conversation: 0;
    in property <string> session-title: "";
    in property <[ChatMessage]> messages;
    // 壁纸库:列表与「当前是哪张」都由 Rust 灌进来,面板不碰文件系统
    in property <[LibraryItem]> library;
    in property <string> library-current: "";
    // 每来一条新消息 Rust 就 +1:消息列表靠它把自己钉到底部(内容长高时自动滚到底)
    in property <int> message-revision: 0;
    // 输入框里还没发出去的字。纯界面状态,和输入框双向绑定。
    in-out property <string> draft: "";

    // 右栏当前显示哪个视图:0 = 会话,1 = 壁纸参数,2 = 壁纸库,3 = 设置。纯界面状态,不进 Rust。
    in-out property <int> view: 0;

    // —— 参数视图(原来「壁纸」页那一套)——
    in property <[PresetItem]> presets;
    in-out property <int> current-preset: 0;
    in property <string> wallpaper-title: "—";
    in property <string> wallpaper-hint: "";
    in property <string> fingerprint: "";
    in-out property <string> preset-summary: "";
    in-out property <string> label-a: "";
    in-out property <string> label-b: "";
    in-out property <string> label-c: "";
    in-out property <float> param-a: 0.5;
    in-out property <float> param-b: 0.5;
    in-out property <float> param-c: 0.5;
    in-out property <float> brightness: 1.0;
    in-out property <float> motion: 0.5;
    in property <string> status: "";

    // 环境底色板由 Rust 按当前壁纸调色板算出来,玻璃因此会"透"出当前壁纸的色。
    in property <color> ambient-a: #1B2A4A;
    in property <color> ambient-b: #4F7CFF;
    in property <color> ambient-c: #0B1020;
    in property <color> glass-tint: #10141F;
    in property <color> accent: #0A84FF;

    // 左键是否正按在标题栏上。只用来判断"这次抬起要不要收尾",
    // 真正的拖动由 Rust 侧驱动(见下面三个 drag-* 回调的说明)。
    private property <bool> drag-active: false;

    // 顶部安全区(自定义标题栏)的底色:比玻璃暗一档的实色,跟着 `glass-tint` 走 ——
    // 换壁纸时窗框的色相也跟着变。用实色是因为软件渲染器下圆角只对实色生效(见文件头)。
    private property <color> caption-plate: glass-tint.darker(0.62);

    // 窗口是不是放大状态。纯界面状态:真正的窗口状态在 Win32 那侧(见 mcwp_platform::glass_window),
    // 面板只知道"该把标题栏那颗键画成放大还是还原"。
    in property <bool> maximized: false;

    // —— 会话的右键菜单:纯界面状态,不进 Rust ——
    // 菜单开着时:对着第几行 + 那行是不是置顶(决定显示「置顶」还是「取消置顶」)+ 弹出点(窗口坐标)。
    private property <int> menu-row: -1;
    private property <bool> menu-pinned: false;
    private property <length> menu-x: 0px;
    private property <length> menu-y: 0px;
    // 菜单尺寸,和 ConversationMenu 里写死的那两个数保持一致(面板靠它把菜单收在窗口内)
    private property <length> menu-w: 176px;
    private property <length> menu-h: 143px;
    // 正在改名的行;-1 = 没人改名。草稿在行自己手里(见 ConversationRow),所以"
    // 点了别处"和 Esc 是一回事:这次改名作废。
    private property <int> rename-row: -1;

    callback select-preset(int);
    callback values-changed();
    callback save-requested();
    callback reset-requested();
    callback close-requested();
    callback drag-start();
    callback drag-move();
    callback drag-end();
    // 顶部安全区右边那三颗窗口键。关窗还是原来的 close-requested(直接退出面板事件循环),
    // 最小化 / 放大交给 Rust 侧调 Win32。
    callback minimize-requested();
    callback toggle-maximize-requested();
    // 生图界面:发消息 / 切会话 / 新建会话
    callback send-message(string);
    callback select-conversation(int);
    callback new-conversation();
    // 左栏会话的右键菜单:改名 / 删除 / 置顶 / 标为未读
    callback rename-conversation(int, string);
    callback delete-conversation(int);
    callback toggle-pin-conversation(int);
    callback mark-conversation-unread(int);
    // 壁纸库:点了某一张 / 切进库页时想要一份最新的列表
    callback open-wallpaper(int);
    callback refresh-library();

    title: "MC 壁纸 · 控制面板";
    // 任务栏 / Alt-Tab 的窗口图标。`@image-url` 走的还是 build.rs 的 EmbedFiles,所以图标
    // 也是编进 exe 的;exe 文件本身的那枚图标另说(那要 rc.exe 写资源,本轮没做)。
    icon: @image-url("../assets/mcwp-icon-256.png");
    // 只给「首选」尺寸,不给 `width` / `height`:那两个是**固定**约束(min = max),窗口一被
    // 系统拉大(放大),根元素还是钉在原尺寸上,内容缩在左上角、右边一大片空玻璃。
    preferred-width: 1024px;
    preferred-height: 672px;
    no-frame: true;
    background: ambient-c;
    default-font-family: "MCWP Sans";
    default-font-size: 14px;

    changed param-a => { root.values-changed(); }
    changed param-b => { root.values-changed(); }
    changed param-c => { root.values-changed(); }
    changed brightness => { root.values-changed(); }
    changed motion => { root.values-changed(); }

    // 发消息:空输入不发(免得刷出一堆空气泡)
    function submit() {
        if (root.draft != "") {
            root.send-message(root.draft);
            root.draft = "";
        }
    }

    // 关掉右键菜单
    function close-menu() {
        root.menu-row = -1;
    }

    // 在窗口坐标 (`at-x`, `at-y`) 处弹菜单,但不许戳出窗口:上下左右各留 8px(和内容层的
    // 18px 内边距是两个概念,这里只是别让菜单贴着边、露出圆角外面的黑边)。
    function open-menu(row: int, pinned: bool, at-x: length, at-y: length) {
        root.menu-row = row;
        root.menu-pinned = pinned;
        root.menu-x = max(8px, min(at-x, root.width - root.menu-w - 8px));
        root.menu-y = max(8px, min(at-y, root.height - root.menu-h - 8px));
    }

    // 收掉正在改名的那一行,不提交(改名只有回车算数)
    function stop-rename() {
        root.rename-row = -1;
    }

    // ——————————————————————————————
    // 内容层:环境底。代替真实的背景模糊 —— 我们自己画一层柔和的多色渐变,
    // 玻璃半透明地盖在上面,看起来就像它在折射背后的东西。
    // ——————————————————————————————
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Glass.r-window;
        background: @linear-gradient(155deg, ambient-a 0%, ambient-c 52%, ambient-b.with-alpha(0.75) 100%);
    }

    // 两团彩色光斑,让底色不平;方形的径向渐变 = 圆形光晕
    Rectangle {
        x: -120px;
        y: -160px;
        width: 620px;
        height: 620px;
        border-radius: 310px;
        background: @radial-gradient(circle, ambient-b 0%, #00000000 68%);
        opacity: 0.5;
    }
    Rectangle {
        x: 520px;
        y: 300px;
        width: 560px;
        height: 560px;
        border-radius: 280px;
        background: @radial-gradient(circle, accent 0%, #00000000 66%);
        opacity: 0.28;
    }

    // ——————————————————————————————
    // 功能层:一整块玻璃,铺满窗口(圆角和窗口对齐)。内部只用薄填充(不再叠玻璃)。
    // ——————————————————————————————
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Glass.r-window;
        border-width: 1px;
        border-color: Glass.hairline;

        // 1) 染色底:跟随当前壁纸色调,压暗保证白字可读
        Rectangle {
            border-radius: parent.border-radius;
            background: @linear-gradient(180deg, glass-tint.with-alpha(0.42) 0%, glass-tint.darker(0.35).with-alpha(0.58) 100%);
        }
        // 2) 白色薄纱:上厚下薄,模拟光从上方来(提亮靠它,不靠把染色调浅)
        Rectangle {
            border-radius: parent.border-radius;
            background: @linear-gradient(180deg, #FFFFFF1F 0%, #FFFFFF0D 38%, #FFFFFF05 100%);
        }
        // 3) 顶部镜面高光:一条横向渐变的细线
        Rectangle {
            x: 14px;
            y: 0.5px;
            width: parent.width - 28px;
            height: 1px;
            background: @linear-gradient(90deg, #FFFFFF00 0%, Glass.specular 45%, #FFFFFF00 100%);
        }
        // 4) 底部内缘暗线:lensing 的"玻璃厚度",让玻璃和下面的内容分层
        Rectangle {
            x: 14px;
            y: parent.height - 1.5px;
            width: parent.width - 28px;
            height: 1px;
            background: @linear-gradient(90deg, #00000000 0%, Glass.rim-dark 50%, #00000000 100%);
        }
        // 5) 左右内缘反光:玻璃边缘把光"折"进来的一道亮边,上亮下无
        Rectangle {
            x: 0.5px;
            y: 14px;
            width: 1px;
            height: parent.height * 0.42;
            background: @linear-gradient(180deg, Glass.specular 0%, #FFFFFF00 100%);
            opacity: 0.55;
        }
        Rectangle {
            x: parent.width - 1.5px;
            y: 14px;
            width: 1px;
            height: parent.height * 0.42;
            background: @linear-gradient(180deg, Glass.specular 0%, #FFFFFF00 100%);
            opacity: 0.55;
        }
    }
    // ——————————————————————————————
    // 顶部安全区(自定义标题栏)。满宽贴边 + 实色,刻意和下面的玻璃不同色 —— 它模仿的是
    // 系统标题栏,不是玻璃上的一张卡片;窗口那圈圆角由 DWM 裁剪,这里不用自己倒角。
    // 右边三颗键是「最小化 / 放大(还原)/ 关闭」,按 Windows 的排布(最右边是关闭)。
    // ——————————————————————————————
    // `x` / `y` 必须显式写:Window 的孩子不带坐标时会被**居中**摆(不是左上角)—— 100% 宽高
    // 的元素看不出差别,一条 36px 高的标题栏会直接跑到窗口正中间去。
    Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 36px;
        background: caption-plate;

        // 底下这条发丝线:深色标题栏压着深色玻璃,没有分界会糊成一片
        Rectangle {
            width: parent.width;
            height: 1px;
            y: parent.height - 1px;
            background: Glass.hairline-dim;
        }

        // 拖拽区铺满整条。三颗按钮是后声明的,浮在上面,事件先到它们手里(和原来那颗关闭钮一样)。
        drag := TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    // 放大状态下不拖:Windows 上拖最大化窗口的标题栏 = 还原 + 继续拖,我们没做
                    // 这套,干脆当成没接住,免得把一块铺满屏幕的窗口拖出工作区。
                    if (!root.maximized) {
                        root.drag-active = true;
                        root.drag-start();
                    }
                } else if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left) {
                    if (root.drag-active) {
                        root.drag-active = false;
                        root.drag-end();
                    }
                } else if (e.kind == PointerEventKind.move && root.drag-active) {
                    // 只在还按着的时候转发:窗口没跟着动(手动拖动)时才需要这条。
                    root.drag-move();
                }
                // Cancel 故意不处理:它就是"指针离开了标题栏"的信号,收了就脱手。
            }
            // 双击标题栏 = 放大 / 还原,Windows 的老规矩
            double-clicked => { root.toggle-maximize-requested(); }
        }

        HorizontalLayout {
            height: 100%;
            padding-left: 18px;
            // 右边给三颗窗口键留位,别让标题压到它们下面
            padding-right: 138px;
            spacing: 8px;

            // 套一层 VBox:横向布局里定高的小圆点会被顶到行顶边(见文件头那条 alignment 的说明)
            VerticalLayout {
                alignment: center;

                Rectangle {
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: accent;
                    opacity: 0.9;
                }
            }
            Text {
                text: "MC 壁纸";
                color: Glass.label-2;
                font-size: 12px;
                font-weight: 600;
                letter-spacing: 0.6px;
                vertical-alignment: center;
            }
            Text {
                text: "·";
                color: Glass.label-3;
                font-size: 12px;
                vertical-alignment: center;
            }
            Text {
                text: "生图";
                color: Glass.label-3;
                font-size: 12px;
                vertical-alignment: center;
            }

            Rectangle { horizontal-stretch: 1; }
        }

        // 右上角三颗窗口键:自右往左 = 关闭 / 放大(还原)/ 最小化
        CaptionButton {
            kind: 3;
            plate: caption-plate;
            x: parent.width - self.width;
            picked => { root.close-requested(); }
        }
        CaptionButton {
            kind: root.maximized ? 2 : 1;
            plate: caption-plate;
            x: parent.width - self.width * 2;
            picked => { root.toggle-maximize-requested(); }
        }
        CaptionButton {
            kind: 0;
            plate: caption-plate;
            x: parent.width - self.width * 3;
            picked => { root.minimize-requested(); }
        }
    }

    // ——————————————————————————————
    // 玻璃上的内容。四周 18px 内边距,离窗口边留出一圈玻璃本色当"边框";
    // 顶上那条 36px 的安全区满宽贴边、放不进这层布局,所以这里让出 54px(= 36 + 18)。
    // ——————————————————————————————
    VerticalLayout {
        width: 100%;
        height: 100%;
        padding: 18px;
        padding-top: 54px;
        spacing: 12px;

        // —— 主体:左栏历史对话 / 右栏会话 —— 
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 14px;

            // ============ 左栏:历史对话 ============
            VerticalLayout {
                width: 244px;
                spacing: 8px;

                Pill {
                    text: "+ 新建对话";
                    primary: true;
                    accent: root.accent;
                    width: 244px;
                    clicked => {
                        root.stop-rename();
                        root.view = 0;
                        root.new-conversation();
                    }
                }

                Text {
                    text: "历史对话";
                    color: Glass.label-3;
                    font-size: 11px;
                    font-weight: 600;
                    letter-spacing: 0.5px;
                }

                flick-conv := Flickable {
                    vertical-stretch: 1;
                    viewport-width: self.width;
                    // 条目定高(50px)+ 6px 间距,内容高度直接算:比问布局要稳
                    viewport-height: max(self.height, root.conversations.length * 56px - 6px);

                    conv-list := VerticalLayout {
                        width: flick-conv.viewport-width;
                        spacing: 6px;
                        alignment: start;

                        for conv[i] in root.conversations : ConversationRow {
                            heading: conv.heading;
                            sub: conv.sub;
                            pinned: conv.pinned;
                            unread: conv.unread;
                            renaming: i == root.rename-row;
                            selected: i == root.current-conversation && root.view == 0;
                            accent: root.accent;

                            picked => {
                                root.stop-rename();
                                root.view = 0;
                                root.current-conversation = i;
                                root.select-conversation(i);
                            }
                            menu-requested(x, y) => {
                                // 先收掉正在改名的行:菜单和输入框同时开着,焦点和命中测试要打架
                                root.stop-rename();
                                root.open-menu(i, conv.pinned, x, y);
                            }
                            rename-committed(text) => {
                                root.rename-row = -1;
                                root.rename-conversation(i, text);
                            }
                            rename-cancelled => { root.rename-row = -1; }
                        }
                    }
                }

                // 底部三个入口:再点一次当前项就回到会话
                NavRow {
                    text: "壁纸参数";
                    active: root.view == 1;
                    accent: root.accent;
                    picked => {
                        root.stop-rename();
                        root.view = root.view == 1 ? 0 : 1;
                    }
                }
                NavRow {
                    text: "壁纸库";
                    active: root.view == 2;
                    accent: root.accent;
                    picked => {
                        root.stop-rename();
                        root.view = root.view == 2 ? 0 : 2;
                        // 切进库页时问一次:库目录被外面改过(手工删、拷别人的壁纸进来)也能跟上
                        if (root.view == 2) { root.refresh-library(); }
                    }
                }
                NavRow {
                    text: "设置";
                    active: root.view == 3;
                    accent: root.accent;
                    picked => {
                        root.stop-rename();
                        root.view = root.view == 3 ? 0 : 3;
                    }
                }
            }
            // ============ 右栏:会话 / 参数 / 库 / 设置 ============
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 10px;

                // 头部:会话标题(或当前视图名)
                HorizontalLayout {
                    height: 26px;
                    spacing: 10px;
                    // 不写 alignment:否则标题会跑到中间,靠右的信息也没法贴边

                    Text {
                        text: root.view == 0
                            ? root.session-title
                            : (root.view == 1 ? "壁纸参数" : (root.view == 2 ? "壁纸库" : "设置"));
                        color: Glass.label;
                        font-size: 17px;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    if root.view == 0 : Text {
                        text: "当前壁纸 · " + root.wallpaper-title;
                        color: Glass.label-3;
                        font-size: 11px;
                        vertical-alignment: center;
                        overflow: elide;
                        max-width: 280px;
                    }
                    if root.view == 1 : Text {
                        text: "指纹 " + root.fingerprint;
                        color: Glass.label-3;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }

                // —— 视图 0:会话 —— 
                if root.view == 0 : VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 10px;

                    // 空态:还没有消息
                    if root.messages.length == 0 : Rectangle {
                        vertical-stretch: 1;
                        border-radius: Glass.r-card;
                        background: Glass.fill;

                        VerticalLayout {
                            alignment: center;
                            spacing: 6px;

                            Text {
                                text: "还没有开始";
                                color: Glass.label;
                                font-size: 16px;
                                font-weight: 600;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "说一句想要的样子,比如「雨夜城市,再冷一点」";
                                color: Glass.label-3;
                                font-size: 12px;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    // 消息流
                    if root.messages.length > 0 : flick-msg := Flickable {
                        vertical-stretch: 1;
                        viewport-width: self.width;
                        viewport-height: msg-list.preferred-height;

                        // 新消息到达 / 切了会话:钉到底部(viewport-y 是滚动偏移,0 = 顶部)。
                        // `changed` 的语法只认本元素作用域里的属性名(写不了 `root.xxx`),
                        // 所以先把 root 的两个信号引成本地属性,再监听它们。
                        private property <int> revision: root.message-revision;
                        private property <int> conversation: root.current-conversation;
                        changed revision => {
                            self.viewport-y = max(0px, self.viewport-height - self.height);
                        }
                        changed conversation => {
                            self.viewport-y = max(0px, self.viewport-height - self.height);
                        }

                        msg-list := VerticalLayout {
                            width: flick-msg.viewport-width;
                            spacing: 10px;
                            alignment: start;

                            for msg[i] in root.messages : MessageRow {
                                body: msg.text;
                                mine: msg.mine;
                                accent: root.accent;
                            }
                        }
                    }
                }

                // —— 视图 1:壁纸参数(原来「壁纸」页的内容,原样搬过来)—— 
                if root.view == 1 : HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: 14px;

                    VerticalLayout {
                        width: 300px;
                        spacing: 8px;

                        Text {
                            text: "场景预设";
                            color: Glass.label-3;
                            font-size: 11px;
                            font-weight: 600;
                            letter-spacing: 0.5px;
                        }

                        for preset[i] in root.presets : PresetRow {
                            selected: i == root.current-preset;
                            heading: preset.title;
                            sub: preset.summary;
                            accent: root.accent;

                            picked => {
                                root.current-preset = i;
                                root.label-a = preset.label-a;
                                root.label-b = preset.label-b;
                                root.label-c = preset.label-c;
                                root.param-a = preset.value-a;
                                root.param-b = preset.value-b;
                                root.param-c = preset.value-c;
                                root.motion = preset.motion;
                                root.preset-summary = preset.summary;
                                root.select-preset(i);
                            }
                        }

                        Rectangle { vertical-stretch: 1; }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        border-radius: Glass.r-card;
                        background: Glass.fill;

                        VerticalLayout {
                            padding: 14px;
                            spacing: 2px;

                            Text {
                                text: "场景参数";
                                color: Glass.label-3;
                                font-size: 11px;
                                font-weight: 600;
                                letter-spacing: 0.5px;
                            }

                            GlassSlider { label: root.label-a; minimum: 0; maximum: 1; accent: root.accent; value <=> root.param-a; }
                            GlassSlider { label: root.label-b; minimum: 0; maximum: 1; accent: root.accent; value <=> root.param-b; }
                            GlassSlider { label: root.label-c; minimum: 0; maximum: 1; accent: root.accent; value <=> root.param-c; }

                            Rectangle { height: 1px; background: Glass.hairline-dim; }

                            GlassSlider { label: "桌面亮度"; minimum: 0.2; maximum: 1.6; accent: root.accent; value <=> root.brightness; }
                            GlassSlider { label: "动势"; minimum: 0; maximum: 1; accent: root.accent; value <=> root.motion; }
                        }
                    }
                }

                // —— 视图 2:壁纸库(列表由壁纸侧扫库目录灌进来,点一张就切过去)—— 
                if root.view == 2 : Rectangle {
                    vertical-stretch: 1;
                    border-radius: Glass.r-card;
                    background: Glass.fill;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;

                        Text {
                            text: "库里存着的每一张都在这里,点一张就切过去";
                            color: Glass.label-3;
                            font-size: 11px;
                        }

                        // 空态:一次都没存过时,教怎么存第一张
                        if root.library.length == 0 : Rectangle {
                            vertical-stretch: 1;

                            Text {
                                text: "库还是空的 —— 到「壁纸参数」里调好,点一下「存为壁纸」,这里就会多出一张。";
                                color: Glass.label-3;
                                font-size: 12px;
                                wrap: word-wrap;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        if root.library.length > 0 : Flickable {
                            vertical-stretch: 1;
                            viewport-width: self.width;
                            // 条目定高(54px)+ 10px 间距,内容高度直接算:比问布局要稳
                            viewport-height: max(self.height, root.library.length * 64px - 10px);

                            VerticalLayout {
                                width: parent.width;
                                spacing: 10px;
                                alignment: start;

                                for item[i] in root.library : LibraryRow {
                                    heading: item.title;
                                    sub: item.hint;
                                    meta: item.id;
                                    accent: item.accent;
                                    selected: item.id == root.library-current;

                                    picked => { root.open-wallpaper(i); }
                                }
                            }
                        }
                    }
                }

                // —— 视图 3:设置(占位)—— 
                if root.view == 3 : Rectangle {
                    vertical-stretch: 1;
                    border-radius: Glass.r-card;
                    background: Glass.fill;

                    VerticalLayout {
                        alignment: center;
                        spacing: 6px;

                        Text {
                            text: "设置";
                            color: Glass.label;
                            font-size: 22px;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "模型密钥 / 开机自启 / 省电策略 · 待接入";
                            color: Glass.label-3;
                            font-size: 12px;
                            horizontal-alignment: center;
                        }
                    }
                }

                // —— 状态行(一次性的反馈都放这儿)—— 
                Text {
                    text: root.status;
                    color: Glass.label-3;
                    font-size: 11px;
                    height: 14px;
                    vertical-alignment: center;
                    overflow: elide;
                }

                // —— 底栏:会话是输入框,参数是操作按钮 —— 
                if root.view == 0 : Rectangle {
                    height: 46px;
                    border-radius: self.height / 2;
                    // 实色凹槽 + 发丝线,和滑杆轨道同一套语言
                    background: #0000003D;
                    border-width: 1px;
                    border-color: input.has-focus ? root.accent.with-alpha(0.65) : Glass.hairline-dim;
                    animate border-color { duration: 140ms; easing: ease-out; }

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 6px;
                        spacing: 8px;
                        // 不写 alignment:写了输入框会塌成文字那么宽并居中

                        input := TextInput {
                            horizontal-stretch: 1;
                            font-size: 13px;
                            color: Glass.label;
                            vertical-alignment: center;
                            text <=> root.draft;
                            accepted => { root.submit(); }
                        }

                        // 发送胶囊竖直居中(横向布局里它会贴着上沿,见文件顶部的布局说明)
                        VerticalLayout {
                            alignment: center;

                            Pill {
                                text: "发送";
                                primary: true;
                                accent: root.accent;
                                width: 76px;
                                clicked => { root.submit(); }
                            }
                        }
                    }

                    // 占位文案:TextInput 没有 placeholder 属性,拿一条绝对定位的 Text 盖上
                    Text {
                        x: 15px;
                        y: (parent.height - self.height) / 2;
                        text: "说一句想看到的样子…";
                        color: Glass.label-3;
                        font-size: 13px;
                        visible: root.draft == "";
                    }
                }

                if root.view == 1 : HorizontalLayout {
                    height: 34px;
                    spacing: 10px;
                    // 不写 alignment:两个按钮贴左边,说明文字贴右边

                    Pill { text: "存为壁纸"; primary: true; accent: root.accent; clicked => { root.save-requested(); } }
                    Pill { text: "恢复默认"; accent: root.accent; clicked => { root.reset-requested(); } }

                    Rectangle { horizontal-stretch: 1; }

                    Text {
                        text: root.preset-summary;
                        color: Glass.label-3;
                        font-size: 11px;
                        vertical-alignment: center;
                        overflow: elide;
                        max-width: 320px;
                    }
                }
            }
        }
    }

    // ——————————————————————————————
    // 会话的右键菜单浮层。**最后声明** = 盖在所有东西之上:菜单开着的时候,连顶部那三颗
    // 窗口键也点不到(点一下先关菜单),和系统菜单的行为一致。
    // ——————————————————————————————
    if root.menu-row >= 0 : Rectangle {
        // 铺满整窗。Window 的孩子不带 x / y 会被居中摆,这里显式钉在左上角(见文件头)。
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;

        // 点菜单以外的地方就收掉。它铺满整窗,菜单声明在它后面 —— 后声明的浮在上面,
        // 所以照旧是"点菜单里的项 → 那一项;点别处 → 关菜单"。
        dismiss := TouchArea {
            clicked => { root.close-menu(); }
        }

        ConversationMenu {
            x: root.menu-x;
            y: root.menu-y;
            pinned: root.menu-pinned;
            plate: root.caption-plate.brighter(0.06);

            rename-picked => {
                // 先开输入框、再收菜单:顺序反过来的话 `menu-row` 已经归 -1,拿不到行号了
                root.rename-row = root.menu-row;
                root.close-menu();
            }
            pin-picked => {
                root.toggle-pin-conversation(root.menu-row);
                root.close-menu();
            }
            unread-picked => {
                root.mark-conversation-unread(root.menu-row);
                root.close-menu();
            }
            delete-picked => {
                root.delete-conversation(root.menu-row);
                root.close-menu();
            }
        }
    }
}
