// MC 壁纸 · 控制面板 —— 生图界面(iOS 26 液态玻璃风格)
//
// 信息架构是两块,顶上再压一条窗口自己的「安全区」(自定义标题栏,见下面「顶部安全区」一段):
//
//   ┌───────────────────────────────────────────────────────────┐
//   │ ● MC 壁纸 · 生图                            −      □      × │
//   ├──────────────┬────────────────────────────────────────────┤
//   │ 历史对话      │ 会话标题                                    │
//   │  + 新建对话   │ ──────────────────────────────────────────  │
//   │  对话一 ·…    │ 消息流(用户的靠右、染色;回复靠左、薄填充)  │
//   │  对话二 ·…    │                                             │
//   │  …            │ ──────────────────────────────────────────  │
//   │  壁纸库       │ [ 说一句想看到的样子…         ] [ 发送 ]    │
//   │  设置         │                                             │
//   └──────────────┴────────────────────────────────────────────┘
//
// 左栏是会话历史常驻的位置,底部两项把右栏换成库 / 设置,顶上那一行留给会话标题。
// `view` 是纯界面状态(0 会话 / 1 壁纸库 / 2 设置),不进 Rust;切视图一律用 `if` 而不是 `visible`。
//
// 老的那一页「壁纸参数」(预设卡片 + 三个滑杆)随**预设清零**一起拆了:画面不再是本地着色器
// 那几个参数算出来的,而是一张生好的图 —— 能改的只有"再生成一张",那件事走右栏的对话。
//
// 壁纸库页的网格不写死在面板里:壁纸侧扫过 `%APPDATA%\MC壁纸\photos` 再整块灌进来
// (`library` / `library-current`),切到库页时回调 `refresh-library` 要一份最新的 ——
// 库目录是用户可写的地方,面板自己不去读文件。缩略图也是壁纸侧在入库时生成好、随列表一起送来的
// (面板这边只负责贴,不做解码)。
//
// —— 视觉与软件渲染器的能力边界(踩过才知道,别重犯)——
//   * 支持:线性/径向渐变、圆角、alpha 混合、旋转、颜色插值动画
//   * 不支持:backdrop-blur、盒阴影(draw_box_shadow 是 TODO)、裁剪路径、渐变描边
//     → 阴影用「径向渐变暗斑」伪造,描边一律实色
//   * **圆角只对实色背景生效**。software_renderer.rs 的 `process_rectangle_impl` 里,渐变是
//     单独一条分支:它把整个矩形直接刷下去(不看 radius),随后那次 `process_rounded_rectangle`
//     拿到的 inner_color 是透明的,等于什么也没画。表现就是「发丝线描边是圆的、填充是直角」。
//     → 凡是要圆角的地方一律用实色(带 alpha 的实色也算);渐变只留给圆角不重要的地方
//       (窗口底色、环境光斑)。
//   * `visible: false` 会被降级成一个 Clip 包裹元素,照样占布局空间;要不占位就用 `if`。
//   * **Window 的孩子不带 `x` / `y` 时会被居中摆**,不是左上角。满窗口的底色看不出来,
//     一条 36px 的标题栏会直接跑到正中间 —— 贴边的元素一律显式写 `x: 0px; y: 0px;`。
//   * 布局的 `alignment` 指的是**主轴**方向:HorizontalLayout 里写 `alignment: center` 会把整条
//     内容挤到中间(横向 stretch 同时也失效,输入框会塌成文字那么宽)。横向布局一律不写它,
//     竖直居中交给布局默认的 cross 居中;真要竖排居中就用 VerticalLayout 的 alignment: center。
//     反过来也要注意:HBox 里**定宽高**的孩子(圆点、色卡、胶囊按钮)没有"竖直居中"可言,
//     它们会被摆在这一行的顶边 —— 要居中就套一层 `VerticalLayout { alignment: center; }`。
//
// 玻璃的三条原则(Apple HIG「Materials / Liquid Glass」+ WWDC25 §219):
//   1. 玻璃是功能层,浮在内容层之上:先铺环境底,玻璃盖上去;玻璃内部不再叠玻璃,
//      只用薄填充 / 白色高光 / 发丝线。
//   2. 软件渲染器没有真·背景模糊,「折射」靠半透明 + 顶部高光 + 底部内缘暗线模拟。
//   3. 玻璃铺满整个窗口,圆角跟 DWM 画的那圈对齐,卡片再用更小的圆角嵌在里面。
//
// 字重约定:动态文案(会话名、消息、输入框里的字)一律用 regular —— 内嵌的 regular 是
// 全字集(GB2312 一级字,见 tools/subset-panel-font.py),bold 只收了面板自己的静态文案,
// 拿 bold 画用户输入的字会静默缺字。标题的层级感靠字号/颜色,不靠字重。
//
// 与 Rust 的唯一接口还是下面这些 property / callback,面板自己不持有任何持久状态:
// 会话列表与消息也是 Rust 传进来的模型,面板只负责画。

// 把子集字体编进 exe。Slint 认 `import "xxx.ttf"` 这种写法:build.rs 的 EmbedFiles 会把
// 字体数据塞进二进制,生成的初始化代码再调 register_font_from_memory() 注册族名。
// 名字必须和下面的 default-font-family 对上,否则回落到系统字体(CJK 会整片画不出来)。
// 字体是子集化的:改了面板文案要重跑 tools/subset-panel-font.py。
import "../fonts/panel-cjk-regular.ttf";
import "../fonts/panel-cjk-bold.ttf";

// 设计令牌。深色玻璃 + iOS 系统色。
global Glass {
    out property <color> label: #FFFFFFFF;
    out property <color> label-2: #EBEBF59E;
    out property <color> label-3: #EBEBF55C;
    out property <color> hairline: #FFFFFF24;
    out property <color> hairline-dim: #FFFFFF14;
    out property <color> specular: #FFFFFF8A;
    out property <color> fill: #FFFFFF14;
    out property <color> fill-strong: #FFFFFF1F;
    out property <color> fill-hover: #FFFFFF2E;
    out property <color> rim-dark: #0000007A;

    // 窗口那一圈圆角由 DWM 画(DWMWCP_ROUND,约 8px),我们画的每一层都跟它对齐 ——
    // 自己画大一点,窗口里就会露出一小块背景色拼成的"墙角"。
    out property <length> r-window: 8px;
    out property <length> r-card: 12px;
}

// 参数视图里的一张预设卡片(原来是"壁纸"页的主内容)。
// 一条消息。`mine` = 用户自己发的那条。
//
// `photo` 是这条回复对应那张壁纸在**壁纸库里的 id**(空串 = 这条消息没有配图)。
// 存的是 id 而不是图片本身:这份结构是**落盘用的**(见 sessions.rs 的 StoredMessage),
// 而图在库里本来就有一份,存路径/存 id 才不会把 sessions.json 撑成几百兆。
export struct ChatMessage {
    mine: bool,
    text: string,
    photo: string,
}

// 面板侧要画的一条消息:`ChatMessage` 是**存起来**的那份(只有 id),这里多带来已经装好的
// 缩略图 —— 消息里的配图要和壁纸库的缩略图对上号,而那个"对号"只有面板线程做得到
// (两边在 `apply_session` / `apply_library` 里各来一次,见 mcwp-ui 的说明)。
//
// `slint::Image` 不是 `Send`,所以它只能出现在这一层,不能跟着 `ChatMessage` 一起跨线程。
export struct ChatBubble {
    mine: bool,
    text: string,
    photo-id: string,
    shot: image,
    /// 这条消息有配图,而且图还在(缩略图拿到了)
    has-shot: bool,
    /// 有配图 id 但库里已经找不到那张了(用户把它删了)—— 界面上明说一句,
    /// 比"图消失了但话还在"更好懂。
    photo-gone: bool,
}

// 左栏里的一条历史对话。
export struct ConversationItem {
    heading: string,
    sub: string,
    // 置顶的排在列表最前面(排序在壁纸侧做,面板只画)
    pinned: bool,
    // 有未读消息:行尾挂一个染色小圆点,切进这个会话就清掉
    unread: bool,
}

// 壁纸库里的一张壁纸(壁纸侧扫描库目录得到)。`thumb` 是**真缩略图** ——
// 壁纸侧在入库时顺手存了一张小的(见 `photos.rs` 的 `THUMB_*`),面板直接贴。
// `accent` 是它调色板里的主色,面板玻璃跟着它染色,所以换壁纸时整个面板的色调一起变。
export struct LibraryItem {
    id: string,
    title: string,
    hint: string,
    summary: string,
    accent: color,
    thumb: image,
    // 这一条是「动态壁纸」(视频)吗。格子角上那个「动」标就看它 ——
    // 库里两种东西混在一起,没有这个标就得靠"这张是不是在动"去分辨,一眼看不出来。
    video: bool,
}
// 玻璃上的「胶囊」按钮。主操作是 tinted(染色玻璃),次操作是普通玻璃。
component Pill inherits Rectangle {
    in property <string> text: "";
    in property <bool> primary: false;
    in property <color> accent: #0A84FF;
    // 文字的色。默认跟着全局的 label 走;「删除」那种要显眼一点的就单独给一个色。
    in property <color> ink: Glass.label;
    // 宽度默认是"三四个字的胶囊",库页那颗「做成动态壁纸」要宽一些。
    in property <length> box-width: 104px;
    // 灰掉 = 这个动作此刻不成立(比如库里没有可删的那张)。灰掉之后不再收点击。
    in property <bool> enabled: true;

    callback clicked();

    height: 34px;
    width: root.box-width;
    opacity: root.enabled ? 1 : 0.4;
    border-radius: self.height / 2;
    border-width: 1px;
    border-color: primary
        ? accent.with-alpha(0.55)
        : (touch.has-hover && root.enabled ? Glass.hairline : Glass.hairline-dim);
    background: primary
        ? (touch.has-hover ? accent.brighter(0.12) : accent)
        : (touch.pressed && root.enabled
            ? Glass.fill-strong
            : (touch.has-hover && root.enabled ? Glass.fill-hover : Glass.fill));
    animate background { duration: 140ms; easing: ease-out; }

    // 顶部高光:一条横向渐变的细线,让胶囊有玻璃厚度
    Rectangle {
        x: parent.width * 0.12;
        y: 0.5px;
        width: parent.width * 0.76;
        height: 1px;
        border-radius: 0.5px;
        background: @linear-gradient(90deg, #FFFFFF00 0%, Glass.specular 50%, #FFFFFF00 100%);
        opacity: primary ? 0.5 : 0.8;
    }

    t := Text {
        text: root.text;
        color: root.ink;
        font-size: 13px;
        font-weight: root.primary ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }

    touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { if (root.enabled) { root.clicked(); } }
    }
}

// 对话进行中那颗「停止生成」圆钮:实心圆 + 一个方块。
//
// **符号是自己画的,不走字体** —— 内嵌子集字体缺字是静默的(见 11.9),图标一旦缺字形就是整块
// 空白,比少个汉字还难看。
//
// 深色面板上"实心黑圆"会糊进背景里:所以反过来 —— 浅色圆 + 深色方块(参考图的暗色版)。
//
// **这里画不了三角**(本来想用三角表示「继续」):Slint 的 `Path` 在软件渲染器里是个 TODO
// (`i-slint-core/src/software_renderer.rs` 的 `draw_path` 是空实现),写了也是静默不画 ——
// 实测踩过。"继续"因此用胶囊文字(Pill),反正那颗钮的文字本来就是中文。
component RunButton inherits Rectangle {
    in property <color> ink: #12141C;

    callback clicked();

    width: 36px;
    height: 36px;
    border-radius: 18px;
    background: touch.has-hover ? #FFFFFF : Glass.label;
    animate background { duration: 140ms; easing: ease-out; }

    // 圆角方块
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 12px;
        height: 12px;
        border-radius: 2px;
        background: root.ink;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// 左栏:一条历史对话。
component ConversationRow inherits Rectangle {
    in property <string> heading: "";
    in property <string> sub: "";
    in property <bool> selected: false;
    in property <bool> pinned: false;
    in property <bool> unread: false;
    // 正在改名:两行文案让位给一个输入框(见下面那段 `if renaming`)
    in property <bool> renaming: false;
    in property <color> accent: #0A84FF;

    // 改名的草稿。只有这一行自己用:面板不存它,回车那一刻才连名字一起交上去,
    // 所以「点了别处」= 草稿丢掉(改名没提交),和 Esc 一个效果。
    private property <string> draft: "";

    // 进改名状态时把草稿重置成当前名字。**不能只靠输入框的 `init`**:行元素会被 slint 复用
    // (列表增删 / 置顶重排都只是换绑模型项),复用到的元素不会再跑一遍 `init`,`draft` 就会
    // 留着上一次 —— 甚至是别的会话 —— 的名字,回车一敲就把别人的名字盖过来了。
    changed renaming => {
        if (root.renaming) {
            root.draft = root.heading;
        }
    }

    callback picked();
    // 右键:告诉我点在**窗口里的**哪个位置(逻辑像素)—— 菜单弹在那儿,所以本行自己把
    // 行内坐标加上 `absolute-position` 再报上去
    callback menu-requested(length, length);
    callback rename-committed(string);
    callback rename-cancelled();

    height: 50px;
    border-radius: Glass.r-card;
    // 未选中时不画描边(透明描边 + 实色填充,圆角才生效)
    border-width: 1px;
    border-color: selected ? accent.with-alpha(0.5) : #FFFFFF00;
    background: selected
        ? accent.with-alpha(touch.has-hover ? 0.22 : 0.16)
        : (touch.has-hover ? Glass.fill-hover : #FFFFFF00);
    animate background { duration: 160ms; easing: ease-out; }

    // 选中指示条:贴在左内缘的一小截染蓝竖条
    Rectangle {
        x: 1px;
        y: 10px;
        width: 2px;
        height: parent.height - 20px;
        border-radius: 1px;
        background: root.selected ? root.accent : #FFFFFF00;
    }

    VerticalLayout {
        padding-left: 14px;
        // 右边给行尾那两个状态标(置顶 / 未读)留位,别让标题压到它们下面
        padding-right: 34px;
        alignment: center;
        spacing: 2px;

        Text {
            text: root.heading;
            visible: !root.renaming;
            color: root.selected ? Glass.label : Glass.label-2;
            font-size: 13px;
            overflow: elide;
            animate color { duration: 160ms; }
        }
        Text {
            text: root.sub;
            visible: !root.renaming;
            color: Glass.label-3;
            font-size: 11px;
            overflow: elide;
        }
    }

    // —— 行尾的状态标:置顶一根小图钉、未读一个染色圆点 ——
    // 图形一律自己画:内嵌子集只收面板文案用得上的字形,图钉这种符号没有。
    if root.pinned : Rectangle {
        x: parent.width - 30px;
        y: (parent.height - 12px) / 2;
        width: 8px;
        height: 12px;

        Rectangle {
            x: 0px;
            y: 0px;
            width: 8px;
            height: 2px;
            border-radius: 1px;
            background: Glass.label-3;
        }
        Rectangle {
            x: 3px;
            y: 3px;
            width: 2px;
            height: 9px;
            background: Glass.label-3;
        }
    }
    if root.unread : Rectangle {
        x: parent.width - 16px;
        y: (parent.height - 7px) / 2;
        width: 7px;
        height: 7px;
        border-radius: 3.5px;
        background: root.accent;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
        pointer-event(e) => {
            // 右键:菜单弹在点下去的地方(左键那条走 clicked,见文件头关于按钮的说明)。
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                root.menu-requested(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y,
                );
            }
        }
    }

    // 改名时的输入框。**放在 `touch` 后面** = 浮在整行之上(和标题栏那三颗窗口键同一个
    // 道理:后声明的先拿事件),敲字、全选、点回来接着改都轮不到下面那颗 TouchArea。
    if root.renaming : Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        border-radius: Glass.r-card;
        background: #00000052;
        border-width: 1px;
        border-color: root.accent.with-alpha(0.65);

        rename-input := TextInput {
            x: 13px;
            y: (parent.height - self.height) / 2;
            width: parent.width - 26px;
            height: 20px;
            font-size: 13px;
            color: Glass.label;
            vertical-alignment: center;
            text <=> root.draft;

            // 建出来就把当前名字填上、聚焦、全选:改名的下一步就是敲字,不该让人再点一次
            init => {
                self.text = root.heading;
                self.focus();
                self.select-all();
            }

            accepted => { root.rename-committed(self.text); }
            key-pressed(e) => {
                // Esc 撤掉这次改名(和系统里改名的习惯一致);其余按键照常交给输入框
                if (e.text == "\u{1b}") {
                    root.rename-cancelled();
                    return accept;
                }
                return reject;
            }
        }
    }
}

// 会话右键菜单里的一行。危险操作(删除)用 `danger` 标出来:悬停整行染红。
//
// 菜单里不放图标:内嵌子集里没有铅笔 / 图钉这类符号,画 12px 的几何图形又太像涂鸦,
// 干脆只用文字 —— 也省得为了菜单再塞一套图片资源进来。
component MenuRow inherits Rectangle {
    in property <string> text: "";
    in property <bool> danger: false;

    callback picked();

    height: 30px;
    border-radius: 6px;
    background: touch.has-hover ? (danger ? #C42B1C38 : Glass.fill-hover) : #00000000;
    animate background { duration: 120ms; easing: ease-out; }

    Text {
        x: 12px;
        y: 0px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.text;
        color: root.danger
            ? (touch.has-hover ? #FFFFFFFF : Glass.label-2)
            : (touch.has-hover ? Glass.label : Glass.label-2);
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
        animate color { duration: 120ms; easing: ease-out; }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
}

// 一条会话的右键菜单:重命名 / 置顶 / 标记为未读 / 删除。
//
// 尺寸(176 × 143)在面板那侧也写着一份(`menu-w` / `menu-h`):菜单得知道自己多大才能
// 贴着窗口边收住,而布局撑出来的高度面板读不到。改行数 / 行高记得两边一起改。
component ConversationMenu inherits Rectangle {
    in property <bool> pinned: false;
    // 菜单底色。由面板传 `caption-plate`(和顶部安全区同一族色),菜单才不会像块外来的板子。
    in property <color> plate: #161B28;

    callback rename-picked();
    callback pin-picked();
    callback unread-picked();
    callback delete-picked();

    width: 176px;
    height: 143px;
    border-radius: 10px;
    // 实色(不是玻璃):菜单要压住底下的内容读字,不该透出会话行
    background: plate;
    border-width: 1px;
    border-color: Glass.hairline;

    VerticalLayout {
        x: 6px;
        y: 6px;
        width: parent.width - 12px;
        height: parent.height - 12px;
        spacing: 0px;

        MenuRow { text: "重命名"; picked => { root.rename-picked(); } }
        MenuRow {
            text: root.pinned ? "取消置顶" : "置顶";
            picked => { root.pin-picked(); }
        }
        MenuRow { text: "标记为未读"; picked => { root.unread-picked(); } }

        // 分隔线:前后各留 5px,和系统菜单里那条一样,把「删除」隔出去
        Rectangle {
            height: 11px;

            Rectangle {
                x: 6px;
                y: 5px;
                width: parent.width - 12px;
                height: 1px;
                background: Glass.hairline-dim;
            }
        }

        MenuRow { text: "删除对话"; danger: true; picked => { root.delete-picked(); } }
    }
}

// 壁纸库里的一格:一张**真缩略图** + 底下一行标题。
//
// 尺寸由外面传进来(`cell-w` / `cell-h`),而不是自己撑出来:网格要靠"每行几格、每格多宽"
// 算坐标,而布局撑出来的尺寸面板读不到(和右键菜单那两个数同一个道理)。格子跟着视口变宽,
// 所以这里的画面部分用 `parent.width` 算,不写死像素。
component LibraryCell inherits Rectangle {
    in property <image> thumb;
    in property <string> heading: "";
    in property <bool> selected: false;
    in property <bool> video: false;
    in property <color> accent: #0A84FF;
    in property <length> cell-w: 168px;
    in property <length> cell-h: 116px;

    callback picked();
    callback menu-requested(length, length);

    width: root.cell-w;
    height: root.cell-h;
    border-radius: Glass.r-card;
    border-width: 1px;
    border-color: root.selected ? root.accent.with-alpha(0.6) : Glass.hairline-dim;
    background: root.selected
        ? root.accent.with-alpha(0.20)
        : (touch.has-hover ? Glass.fill-hover : Glass.fill);
    animate background { duration: 160ms; easing: ease-out; }

    Image {
        x: 6px;
        y: 6px;
        width: parent.width - 12px;
        // 底下一行标题固定占 22px(6px 下边距 + 16px 字高)
        height: parent.height - 28px;
        source: root.thumb;
        image-fit: cover;
    }

    // 「动」标:视频那一格才画。位置挑在缩略图右上角 —— 右下角是生图水印的地盘,
    // 左下角压着画面主体,右上角最空。底色用当前壁纸的强调色玻璃,和面板整体一致。
    if root.video : Rectangle {
        x: parent.width - 40px;
        y: 12px;
        width: 28px;
        height: 16px;
        border-radius: 8px;
        background: root.accent.with-alpha(0.82);

        Text {
            width: parent.width;
            height: parent.height;
            text: "动";
            color: #FFFFFFFF;
            font-size: 10px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Text {
        x: 8px;
        y: parent.height - 22px;
        width: parent.width - 16px;
        height: 16px;
        text: root.heading;
        color: root.selected ? Glass.label : Glass.label-2;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
        pointer-event(e) => {
            // 右键:菜单弹在点下去的地方(左键那条走 clicked,和会话行同一个写法)
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                root.menu-requested(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y,
                );
            }
        }
    }
}

// 壁纸库那一格的右键菜单:换上这一张 / 做成动态壁纸 / 删除这一张。
//
// 只有三项,所以比会话菜单矮(123 而不是 143):面板那侧各存了一份尺寸,
// 菜单得知道自己多大才能贴着窗口边收住(布局撑出来的高度面板读不到)。
component LibraryMenu inherits Rectangle {
    in property <color> plate: #161B28;
    // 这一格是视频吗。是的话不画「做成动态壁纸」(它已经是动态的了)。
    in property <bool> is-video: false;

    callback apply-picked();
    callback animate-picked();
    callback delete-picked();

    width: 176px;
    // 高度跟着"有没有「做成动态壁纸」那一项"走:给视频那条少一行。
    // 面板那侧 `lib-menu-h` 也照这个规则算,两边必须一致 —— 它靠这个数把菜单收在窗口内。
    height: root.is-video ? 93px : 123px;
    border-radius: 10px;
    // 实色(不是玻璃):菜单要压住底下的缩略图读字
    background: plate;
    border-width: 1px;
    border-color: Glass.hairline;

    VerticalLayout {
        x: 6px;
        y: 6px;
        width: parent.width - 12px;
        height: parent.height - 12px;
        spacing: 0px;

        MenuRow { text: "换上这一张"; picked => { root.apply-picked(); } }
        // 「做成动态壁纸」只对静图有意义。已经在动的那一张不画这一项 ——
        // 画出来再点一下就报"这张已经是动态壁纸了",不如干脆不要出现。
        if !root.is-video : MenuRow {
            text: "做成动态壁纸";
            picked => { root.animate-picked(); }
        }

        Rectangle {
            height: 11px;

            Rectangle {
                x: 6px;
                y: 5px;
                width: parent.width - 12px;
                height: 1px;
                background: Glass.hairline-dim;
            }
        }

        MenuRow { text: "删除这一张"; danger: true; picked => { root.delete-picked(); } }
    }
}

// 一条回复下面那张预览图的右键菜单:看大图 / 设为壁纸。
//
// 为什么要有它:生图**不再自动换壁纸**了(画完只进库),于是"想用这一张"必须有个当场的入口 ——
// 让用户切到库页、在一堆缩略图里把刚画出来的那张找出来,正是这一轮要消掉的麻烦。
//
// 尺寸(176 × 82)在面板那侧也写着一份(`shot-menu-h`):菜单得知道自己多大,才能贴着窗口边收住
// (布局撑出来的高度面板读不到)。高度按库菜单那套算:两行 30px + 上下各 6px 内边距 = 72,
// 再和它一样多留 10px 余量。
component ShotMenu inherits Rectangle {
    in property <color> plate: #161B28;

    callback view-picked();
    callback apply-picked();

    width: 176px;
    height: 82px;
    border-radius: 10px;
    // 实色(不是玻璃):菜单要压住底下的预览图读字
    background: plate;
    border-width: 1px;
    border-color: Glass.hairline;

    VerticalLayout {
        x: 6px;
        y: 6px;
        width: parent.width - 12px;
        height: parent.height - 12px;
        spacing: 0px;

        MenuRow { text: "看大图"; picked => { root.view-picked(); } }
        MenuRow { text: "设为壁纸"; picked => { root.apply-picked(); } }
    }
}

// 左栏底部:切到「壁纸参数 / 壁纸库 / 设置」。再点一次回到会话。
component NavRow inherits Rectangle {
    in property <string> text: "";
    in property <bool> active: false;
    in property <color> accent: #0A84FF;

    callback picked();

    height: 32px;
    border-radius: 8px;
    background: active
        ? accent.with-alpha(0.18)
        : (touch.has-hover ? Glass.fill-hover : #FFFFFF00);
    animate background { duration: 140ms; easing: ease-out; }

    HorizontalLayout {
        padding-left: 11px;
        spacing: 9px;

        // 套一层 VBox:横向布局里定高的圆点会被顶到行顶边,竖直居中得靠 VBox 的主轴居中
        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: active ? accent : Glass.label-3;
                opacity: active ? 1 : 0.45;
            }
        }
        Text {
            text: root.text;
            color: active ? Glass.label : Glass.label-2;
            font-size: 12px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
}

// 顶部安全区右边的一颗窗口键:最小化 / 放大 / 还原 / 关闭。
//
// 图形一律自己画(横线、方框):内嵌子集只收了面板文案用得到的字形,「最小化」「还原」
// 这类符号有没有全看运气。关闭那颗是例外 —— × 在子集里(原来的关闭圆钮用的就是它)。
// 尺寸照 Windows 的惯例:46px 宽、满高、只填充不描边,关闭键悬停变红。
component CaptionButton inherits Rectangle {
    in property <int> kind: 1;             // 0 最小化 / 1 放大 / 2 还原 / 3 关闭
    in property <color> plate: #0B0F19;    // 标题栏底色(「还原」那块要拿它遮掉后面一格)

    callback picked();

    width: 46px;
    height: 100%;
    background: touch.has-hover ? (kind == 3 ? #C42B1C : Glass.fill-hover) : #00000000;
    animate background { duration: 120ms; }

    if kind == 3 : Text {
        width: 100%;
        height: 100%;
        text: "×";
        color: touch.has-hover ? #FFFFFFFF : Glass.label-2;
        font-size: 16px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // 最小化:一条横线
    if kind == 0 : Rectangle {
        width: 10px;
        height: 1px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Glass.label-2;
    }

    // 放大:一个方框
    if kind == 1 : Rectangle {
        width: 10px;
        height: 10px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-width: 1px;
        border-color: Glass.label-2;
    }

    // 还原:两个错开的方框,前面那格用标题栏底色盖掉后面那格的右下角
    if kind == 2 : Rectangle {
        width: 9px;
        height: 9px;
        x: (parent.width - self.width) / 2 + 2px;
        y: (parent.height - self.height) / 2 - 2px;
        border-width: 1px;
        border-color: Glass.label-2;
    }
    if kind == 2 : Rectangle {
        width: 9px;
        height: 9px;
        x: (parent.width - self.width) / 2 - 2px;
        y: (parent.height - self.height) / 2 + 2px;
        border-width: 1px;
        border-color: Glass.label-2;
        background: plate;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
}

// 右栏:一条消息。用户的气泡靠右、染色;回复靠左、薄填充。
component MessageRow inherits HorizontalLayout {
    in property <string> body: "";
    in property <bool> mine: false;
    in property <color> accent: #0A84FF;
    // 这条回复生出来的那张壁纸(缩略图)。`has-shot` 为假时下面那条竖排里就只有一个气泡。
    in property <image> shot;
    in property <bool> has-shot: false;
    in property <bool> photo-gone: false;

    callback preview();
    callback menu-requested(length, length);

    // 靠边:用户消息靠右、回复靠左,两侧各留 6px 给圆角喘口气。
    //
    // **两处都靠"往另一边垫一个伸缩项"实现,所以那个伸缩项的先后位置就是左右的分界线** ——
    // 用户的垫在气泡前面,回复的垫在后面。原来两条都写在气泡前面,结果回复也贴着右边缘
    // (和用户消息糊成一列,看不出谁说的),实测踩过。
    padding-left: 6px;
    padding-right: 6px;
    if mine : Rectangle { horizontal-stretch: 1; }

    bubble := Rectangle {
        // 贴着内容大小,不被行高拉伸
        vertical-stretch: 0;
        horizontal-stretch: 0;
        min-width: 56px;
        max-width: 440px;
        border-radius: 14px;
        border-width: 1px;
        border-color: mine ? accent.with-alpha(0.45) : Glass.hairline-dim;
        // 实色(带 alpha 的实色也算),圆角才生效
        background: mine ? accent.with-alpha(0.26) : Glass.fill;

        VerticalLayout {
            padding: 10px;
            spacing: 8px;
            Text {
                text: root.body;
                wrap: word-wrap;
                color: Glass.label;
                font-size: 13px;
            }

            // 生出来的那张图,直接贴在回复下面当预览。
            //
            // 为什么不是"点文字开大图":这条回复说的是"已换上「雪山湖晨光」",而**画面本身**
            // 才是用户想确认的东西 —— 看不到就得切到库页去找。缩略图就在手上(和库页同一份),
            // 贴出来几乎不花代价。
            if root.has-shot : Rectangle {
                width: 244px;
                height: 148px;
                border-radius: 10px;
                // 圆角要裁图:Slint 的 Image 自己没有圆角,不裁就是一张方角图压在一个圆角底上
                clip: true;
                border-width: 1px;
                border-color: shot-touch.has-hover
                    ? root.accent.with-alpha(0.55)
                    : Glass.hairline-dim;
                background: Glass.fill;

                Image {
                    width: 100%;
                    height: 100%;
                    source: root.shot;
                    image-fit: cover;
                }

                shot-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.preview(); }
                    // 右键:菜单弹在点下去的地方(和库格、会话行同一个写法)。
                    // **配图已经不在了就不弹** —— 菜单里那两项(看大图 / 设为壁纸)都要去库里找它,
                    // 弹出来只会让每一行点了都失败;那一行文字已经写着"这张已经不在壁纸库里了"。
                    pointer-event(e) => {
                        if (!root.photo-gone
                            && e.kind == PointerEventKind.down
                            && e.button == PointerEventButton.right) {
                            root.menu-requested(
                                self.absolute-position.x + self.mouse-x,
                                self.absolute-position.y + self.mouse-y,
                            );
                        }
                    }
                }
            }

            if root.has-shot : Text {
                text: "点一下看大图 · 右键可设为壁纸";
                color: Glass.label-3;
                font-size: 10px;
                horizontal-alignment: left;
            }

            // 配图被删了:说明白,别让用户以为是加载失败
            if root.photo-gone : Text {
                text: "这张已经不在壁纸库里了";
                color: Glass.label-3;
                font-size: 11px;
            }
        }
    }

    if !mine : Rectangle { horizontal-stretch: 1; }
}

// 设置页里的一行:左边固定宽的标签 + 右边一个输入框。三行(接口地址 / 模型名 / Key)共用它,
// 免得同一段样式抄三遍。
component FieldRow inherits HorizontalLayout {
    in property <string> label: "";
    in property <string> placeholder: "";
    in-out property <string> value: "";
    in property <color> accent: #0A84FF;

    height: 38px;
    spacing: 10px;

    Text {
        text: root.label;
        color: Glass.label-2;
        font-size: 12px;
        width: 68px;
        vertical-alignment: center;
    }

    Rectangle {
        horizontal-stretch: 1;
        border-radius: 8px;
        // 凹槽 + 发丝线,和会话输入框同一套语言
        background: #0000003D;
        border-width: 1px;
        border-color: field.has-focus ? root.accent.with-alpha(0.65) : Glass.hairline-dim;
        animate border-color { duration: 140ms; easing: ease-out; }

        // 占位提示:Slint 的 TextInput 没有 placeholder 属性,自己补一层灰字。
        // 声明在输入框**前面**:后声明的画在上面,反过来这层灰字会盖住输入框吃不到点击。
        if root.value == "" : Text {
            x: 10px;
            width: parent.width - 20px;
            height: 100%;
            text: root.placeholder;
            color: Glass.label-3;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }

        field := TextInput {
            x: 10px;
            width: parent.width - 20px;
            height: 100%;
            font-size: 12px;
            color: Glass.label;
            vertical-alignment: center;
            single-line: true;
            // 这里**不能用 `input-type: password`**:Slint 打码用的字符是 ●(U+25CF),
            // 而内嵌子集字体里没有 ●(见 tools/subset-panel-font.py 的输出),缺字是静默不画 ——
            // 结果就是"key 明明存着,输入框看着却是空的",比明文更容易让人以为没配。
            // key 本来就以明文躺在 ai.json 里,索性就明文显示。
            text <=> root.value;
        }
    }
}

// 设置页里三选一的一行(目前只有「深度思考」用)。
//
// 为什么不是开关:「请求体里不带这个字段」和「带一个 false」是两件不同的事 —— 不认 `thinking`
// 的服务商必须走前者(传了可能直接 400),而智谱 4.7 系列又想显式把它关掉。两个状态表达不了
// 三件事,所以做成一排小胶囊。
component ChoiceRow inherits HorizontalLayout {
    in property <string> label: "";
    in property <[string]> options: [];
    in-out property <int> current: 0;
    in property <color> accent: #0A84FF;

    height: 34px;
    spacing: 8px;

    Text {
        text: root.label;
        color: Glass.label-2;
        font-size: 12px;
        width: 68px;
        vertical-alignment: center;
    }

    for option[index] in root.options : Rectangle {
        width: 58px;
        height: 24px;
        border-radius: 12px;
        border-width: 1px;
        border-color: root.current == index ? root.accent.with-alpha(0.55) : Glass.hairline-dim;
        background: root.current == index ? root.accent.with-alpha(0.22) : #0000003D;
        animate background { duration: 140ms; easing: ease-out; }

        Text {
            text: option;
            color: root.current == index ? Glass.label : Glass.label-2;
            font-size: 11px;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: 100%;
            height: 100%;
        }

        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.current = index; }
        }
    }

    Text {
        color: Glass.label-3;
        font-size: 11px;
        vertical-alignment: center;
        overflow: elide;
        horizontal-stretch: 1;
    }
}
export component Panel inherits Window {
    // —— 会话视图:左栏历史 + 右栏消息 ——
    in property <[ConversationItem]> conversations;
    in-out property <int> current-conversation: 0;
    in property <string> session-title: "";
    // 面板画的是 `ChatBubble`(**带装好的缩略图**),不是落盘那份 `ChatMessage` ——
    // 两者的换算在 `apply_session` 里做(见 mcwp-ui 的说明)。
    in property <[ChatBubble]> messages;
    // 壁纸库:列表与「当前是哪张」都由 Rust 灌进来,面板不碰文件系统
    in property <[LibraryItem]> library;
    in property <string> library-current: "";
    // 「当前那张」在 `library` 里的下标;-1 = 桌面上挂的那张不在库里(比如刚抬进来还没入库)。
    // 库页那颗「删除」靠它知道删哪一个 —— 面板不去自己找下标(找法只有壁纸侧知道)。
    in property <int> library-current-index: -1;
    // 当前那张的标题:删除前要问一句"删的是哪张"。
    in property <string> library-current-title: "";
    // 「删除」的二次确认:开着的时候盖一层确认框。
    in-out property <bool> confirm-delete: false;

    // 看大图:点消息里的预览图会亮起这一层,盖住整个面板。
    //
    // 大图由 Rust 在点开时**现解**(缩略图只有 320×180,放大看是糊的),关掉时 Rust 会把
    // 这份像素丢掉 —— 所以它是一个"用一下就还回去"的资源,不是常驻状态。
    in property <image> viewer;
    // in-out:关掉大图是**面板自己**就能做的决定(点一下),不用先绕一圈 Rust 再回来;
    // 但像素由 Rust 持有,所以还要 `viewer-closed()` 通知它把那份内存放掉。
    in-out property <bool> viewing: false;
    in property <string> viewer-title: "";
    // 每来一条新消息 Rust 就 +1:消息列表靠它把自己钉到底部(内容长高时自动滚到底)
    in property <int> message-revision: 0;
    // 输入框里还没发出去的字。纯界面状态,和输入框双向绑定。
    in-out property <string> draft: "";
    // 这一轮对话跑到哪儿了:0 = 闲着 / 1 = 正在跑(发送键变成暂停圆钮)/ 2 = 已暂停。
    // 由 Rust 在起跑、暂停、落地这三个时刻灌进来 —— 它不属于会话数据,面板自己算不出来。
    in property <int> run-state: 0;

    // —— 设置页:模型配置(接生图那一环)——
    // 这四个是 in-out,但**不放进 PanelState**:它们平时是用户在编辑,而 `refresh()`
    // 会因为换壁纸、切会话随时整块回填 —— 那会把用户正在敲的字冲掉。所以只由 Rust 在
    // 「打开面板」和「保存成功」两个时刻单独灌一次(见 mcwp_ui::PanelHandle::refresh_ai)。
    in-out property <string> ai-base-url: "";
    in-out property <string> ai-model: "";
    in-out property <string> ai-key: "";
    // 生图那一组。**留空 = 跟着上面那三个走**,所以"同一家服务商"时只填上面那组就够。
    in-out property <string> ai-image-base-url: "";
    in-out property <string> ai-image-model: "";
    in-out property <string> ai-image-key: "";
    // 生图画质:0 = 标准 / 1 = 高清。**不是"越大越好"的滑块** —— 服务商只认
    // hd / standard 两个字面值,面板原样交给 Rust 落盘(`QualityChoice`)。
    // 默认高清:standard 出来的图明显更糊(实测高频细节少 41%)。
    in-out property <int> ai-image-quality: 1;
    // 生图水印:0 = 不加 / 1 = 加。**默认不加** —— 那枚「AI生成」是服务商盖的,
    // 关掉它要账号先在「个人中心 → 安全管理 → 去水印管理」签过免责声明;
    // 没签的账号请求会被拒,壁纸侧会退回带水印重发一张(见 `mcwp_ai::Images::generate`)。
    in-out property <int> ai-image-watermark: 0;
    // 图生视频的模型名。地址和 key 都跟生图那组走(同一家服务商的同一个接口域),
    // 所以这里只留一个模型名 —— 多两个输入框只会让人不知道该填哪个(见 `VideosConfig::load`)。
    in-out property <string> ai-video-model: "";
    // 深度思考:0 = 不发这个字段(服务商默认)/ 1 = 发 enabled / 2 = 发 disabled。
    // 三态不是偷懒 —— 面板把它原样交给 Rust,由 Rust 决定 `Stored::thinking` 落 None/true/false。
    in-out property <int> ai-thinking: 0;
    // 有 MCWP_AI_* 环境变量在生效 —— 界面上得说一句,不然用户在这儿改完发现没反应。
    in property <bool> ai-env-override: false;

    // 右栏当前显示哪个视图:0 = 会话,1 = 壁纸库,2 = 设置。纯界面状态,不进 Rust。
    in-out property <int> view: 0;

    // 顶栏右边那行小字:现在挂在桌面上的是哪张
    in property <string> wallpaper-title: "—";
    in property <string> status: "";

    // 环境底色板由 Rust 按当前壁纸调色板算出来,玻璃因此会"透"出当前壁纸的色。
    in property <color> ambient-a: #1B2A4A;
    in property <color> ambient-b: #4F7CFF;
    in property <color> ambient-c: #0B1020;
    in property <color> glass-tint: #10141F;
    in property <color> accent: #0A84FF;

    // 左键是否正按在标题栏上。只用来判断"这次抬起要不要收尾",
    // 真正的拖动由 Rust 侧驱动(见下面三个 drag-* 回调的说明)。
    private property <bool> drag-active: false;

    // 顶部安全区(自定义标题栏)的底色:比玻璃暗一档的实色,跟着 `glass-tint` 走 ——
    // 换壁纸时窗框的色相也跟着变。用实色是因为软件渲染器下圆角只对实色生效(见文件头)。
    private property <color> caption-plate: glass-tint.darker(0.62);

    // 窗口是不是放大状态。纯界面状态:真正的窗口状态在 Win32 那侧(见 mcwp_platform::glass_window),
    // 面板只知道"该把标题栏那颗键画成放大还是还原"。
    in property <bool> maximized: false;

    // —— 会话的右键菜单:纯界面状态,不进 Rust ——
    // 菜单开着时:对着第几行 + 那行是不是置顶(决定显示「置顶」还是「取消置顶」)+ 弹出点(窗口坐标)。
    private property <int> menu-row: -1;
    private property <bool> menu-pinned: false;
    private property <length> menu-x: 0px;
    private property <length> menu-y: 0px;
    // 菜单尺寸,和 ConversationMenu 里写死的那两个数保持一致(面板靠它把菜单收在窗口内)
    private property <length> menu-w: 176px;
    private property <length> menu-h: 143px;
    // 正在改名的行;-1 = 没人改名。草稿在行自己手里(见 ConversationRow),所以"
    // 点了别处"和 Esc 是一回事:这次改名作废。
    private property <int> rename-row: -1;

    // —— 壁纸库那一格的右键菜单:另一份状态,和会话菜单**分开** ——
    // 两边共用一套坐标本来也行("同时只开一个"),但那样两处 `if` 会一起命中,
    // 两个菜单叠在同一处画出来。分开存变量的代价只是两对坐标,换来的是不必推理"谁先关谁"。
    private property <int> lib-menu-row: -1;
    // 这一格是不是视频。是视频就不显示「做成动态壁纸」,菜单也因此矮一行 ——
    // 所以它既要喂给菜单(`is-video`),也要参与算高度。在 `open-lib-menu` 里定,
    // 那里一定能拿到一个合法的行号(只有格子会调它),不必担心越界读模型。
    private property <bool> lib-menu-video: false;
    // 库菜单比会话菜单矮,而且**自己也会变**:视频那条少一项(见 `LibraryMenu`)。
    // Rust 侧不用管这个数,它只在窗口内收住菜单时用。
    private property <length> lib-menu-h: root.lib-menu-video ? 93px : 123px;

    // —— 消息预览图那张的右键菜单:再一份状态 ——
    // 存的是**那张图的 id**(不是消息行号):菜单开着的时候用户还能发新消息、删会话,
    // 行号会指到别处去,id 不会。
    private property <string> shot-menu-photo: "";
    private property <length> shot-menu-h: 82px;

    callback close-requested();
    callback drag-start();
    callback drag-move();
    callback drag-end();
    // 顶部安全区右边那三颗窗口键。关窗还是原来的 close-requested(直接退出面板事件循环),
    // 最小化 / 放大交给 Rust 侧调 Win32。
    callback minimize-requested();
    callback toggle-maximize-requested();
    // 生图界面:发消息 / 切会话 / 新建会话
    callback send-message(string);
    // 点了消息里那张预览图:把壁纸库里那张的**大图**打开(壁纸侧现解 → `viewer`)
    callback open-photo(string);
    // 大图关掉了:让壁纸侧把那份像素放掉(它占的是几 MB 的 RGBA)
    callback viewer-closed();
    // 预览图右键菜单:把这张(id)换到桌面上去。生图不再自动换,这是"我想用这张"的入口。
    callback set-as-wallpaper(string);
    // 库页那颗「导入图片」:开系统的选文件框,把选中的图收进库里
    callback import-wallpaper();
    callback select-conversation(int);
    callback new-conversation();
    // 对话进行中的暂停 / 继续
    callback pause-run();
    callback resume-run();
    // 左栏会话的右键菜单:改名 / 删除 / 置顶 / 标为未读
    callback rename-conversation(int, string);
    callback delete-conversation(int);
    callback toggle-pin-conversation(int);
    callback mark-conversation-unread(int);
    // 壁纸库:点了某一张 / 切进库页时想要一份最新的列表
    callback open-wallpaper(int);
    callback refresh-library();
    // 壁纸库那一格的右键菜单:删掉第 `index` 张
    callback delete-wallpaper(int);
    // 「做成动态壁纸」:把第 `index` 张静图交给图生视频(跑几十秒,结果回来再上屏)
    callback make-video(int);
    // 同一件事,但对象是**当前挂着的那张**(库页工具栏上那颗钮;不用先去网格里找它)
    callback make-video-current();
    // 把「现在桌面上那张壁纸」抬进来当作一张新的(生图之前先有东西可看)
    callback adopt-wallpaper();
    // 设置页:保存模型配置(接口地址 / 模型名 / API Key / 深度思考那一档的下标)
    callback save-ai-config(string, string, string, int, string, string, string, int, int, string);

    title: "MC 壁纸 · 控制面板";
    // 任务栏 / Alt-Tab 的窗口图标。`@image-url` 走的还是 build.rs 的 EmbedFiles,所以图标
    // 也是编进 exe 的;exe 文件本身的那枚图标另说(那要 rc.exe 写资源,本轮没做)。
    icon: @image-url("../assets/mcwp-icon-256.png");
    // 只给「首选」尺寸,不给 `width` / `height`:那两个是**固定**约束(min = max),窗口一被
    // 系统拉大(放大),根元素还是钉在原尺寸上,内容缩在左上角、右边一大片空玻璃。
    preferred-width: 1024px;
    preferred-height: 672px;
    no-frame: true;
    background: ambient-c;
    default-font-family: "MCWP Sans";
    default-font-size: 14px;

    // 发消息:空输入不发(免得刷出一堆空气泡)
    function submit() {
        if (root.draft != "") {
            root.send-message(root.draft);
            root.draft = "";
        }
    }

    // 关掉右键菜单
    function close-menu() {
        root.menu-row = -1;
    }

    // 在窗口坐标 (`at-x`, `at-y`) 处弹菜单,但不许戳出窗口:上下左右各留 8px(和内容层的
    // 18px 内边距是两个概念,这里只是别让菜单贴着边、露出圆角外面的黑边)。
    function open-menu(row: int, pinned: bool, at-x: length, at-y: length) {
        root.menu-row = row;
        root.menu-pinned = pinned;
        root.menu-x = max(8px, min(at-x, root.width - root.menu-w - 8px));
        root.menu-y = max(8px, min(at-y, root.height - root.menu-h - 8px));
    }

    // 库菜单的两个函数:和上面那对一一对应,只是换了行号变量和高度
    function close-lib-menu() {
        root.lib-menu-row = -1;
    }

    function open-lib-menu(row: int, at-x: length, at-y: length) {
        root.lib-menu-row = row;
        root.lib-menu-video = root.library[row].video;
        root.menu-x = max(8px, min(at-x, root.width - root.menu-w - 8px));
        root.menu-y = max(8px, min(at-y, root.height - root.lib-menu-h - 8px));
    }

    // 消息预览图右键:只记 id 和落点(见 `shot-menu-photo` 的说明)
    function close-shot-menu() {
        root.shot-menu-photo = "";
    }
    function open-shot-menu(row: int, at-x: length, at-y: length) {
        root.shot-menu-photo = root.messages[row].photo-id;
        root.menu-x = max(8px, min(at-x, root.width - root.menu-w - 8px));
        root.menu-y = max(8px, min(at-y, root.height - root.shot-menu-h - 8px));
    }

    // 收掉正在改名的那一行,不提交(改名只有回车算数)
    function stop-rename() {
        root.rename-row = -1;
    }

    // ——————————————————————————————
    // 内容层:环境底。代替真实的背景模糊 —— 我们自己画一层柔和的多色渐变,
    // 玻璃半透明地盖在上面,看起来就像它在折射背后的东西。
    // ——————————————————————————————
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Glass.r-window;
        background: @linear-gradient(155deg, ambient-a 0%, ambient-c 52%, ambient-b.with-alpha(0.75) 100%);
    }

    // 两团彩色光斑,让底色不平;方形的径向渐变 = 圆形光晕
    Rectangle {
        x: -120px;
        y: -160px;
        width: 620px;
        height: 620px;
        border-radius: 310px;
        background: @radial-gradient(circle, ambient-b 0%, #00000000 68%);
        opacity: 0.5;
    }
    Rectangle {
        x: 520px;
        y: 300px;
        width: 560px;
        height: 560px;
        border-radius: 280px;
        background: @radial-gradient(circle, accent 0%, #00000000 66%);
        opacity: 0.28;
    }


    // ——————————————————————————————
    // 功能层:一整块玻璃,铺满窗口(圆角和窗口对齐)。内部只用薄填充(不再叠玻璃)。
    // ——————————————————————————————
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Glass.r-window;
        border-width: 1px;
        border-color: Glass.hairline;

        // 1) 染色底:跟随当前壁纸色调,压暗保证白字可读
        Rectangle {
            border-radius: parent.border-radius;
            background: @linear-gradient(180deg, glass-tint.with-alpha(0.42) 0%, glass-tint.darker(0.35).with-alpha(0.58) 100%);
        }
        // 2) 白色薄纱:上厚下薄,模拟光从上方来(提亮靠它,不靠把染色调浅)
        Rectangle {
            border-radius: parent.border-radius;
            background: @linear-gradient(180deg, #FFFFFF1F 0%, #FFFFFF0D 38%, #FFFFFF05 100%);
        }
        // 3) 顶部镜面高光:一条横向渐变的细线
        Rectangle {
            x: 14px;
            y: 0.5px;
            width: parent.width - 28px;
            height: 1px;
            background: @linear-gradient(90deg, #FFFFFF00 0%, Glass.specular 45%, #FFFFFF00 100%);
        }
        // 4) 底部内缘暗线:lensing 的"玻璃厚度",让玻璃和下面的内容分层
        Rectangle {
            x: 14px;
            y: parent.height - 1.5px;
            width: parent.width - 28px;
            height: 1px;
            background: @linear-gradient(90deg, #00000000 0%, Glass.rim-dark 50%, #00000000 100%);
        }
        // 5) 左右内缘反光:玻璃边缘把光"折"进来的一道亮边,上亮下无
        Rectangle {
            x: 0.5px;
            y: 14px;
            width: 1px;
            height: parent.height * 0.42;
            background: @linear-gradient(180deg, Glass.specular 0%, #FFFFFF00 100%);
            opacity: 0.55;
        }
        Rectangle {
            x: parent.width - 1.5px;
            y: 14px;
            width: 1px;
            height: parent.height * 0.42;
            background: @linear-gradient(180deg, Glass.specular 0%, #FFFFFF00 100%);
            opacity: 0.55;
        }
    }
    // ——————————————————————————————
    // 顶部安全区(自定义标题栏)。满宽贴边 + 实色,刻意和下面的玻璃不同色 —— 它模仿的是
    // 系统标题栏,不是玻璃上的一张卡片;窗口那圈圆角由 DWM 裁剪,这里不用自己倒角。
    // 右边三颗键是「最小化 / 放大(还原)/ 关闭」,按 Windows 的排布(最右边是关闭)。
    // ——————————————————————————————
    // `x` / `y` 必须显式写:Window 的孩子不带坐标时会被**居中**摆(不是左上角)—— 100% 宽高
    // 的元素看不出差别,一条 36px 高的标题栏会直接跑到窗口正中间去。
    Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 36px;
        background: caption-plate;

        // 底下这条发丝线:深色标题栏压着深色玻璃,没有分界会糊成一片
        Rectangle {
            width: parent.width;
            height: 1px;
            y: parent.height - 1px;
            background: Glass.hairline-dim;
        }

        // 拖拽区铺满整条。三颗按钮是后声明的,浮在上面,事件先到它们手里(和原来那颗关闭钮一样)。
        drag := TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    // 放大状态下不拖:Windows 上拖最大化窗口的标题栏 = 还原 + 继续拖,我们没做
                    // 这套,干脆当成没接住,免得把一块铺满屏幕的窗口拖出工作区。
                    if (!root.maximized) {
                        root.drag-active = true;
                        root.drag-start();
                    }
                } else if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left) {
                    if (root.drag-active) {
                        root.drag-active = false;
                        root.drag-end();
                    }
                } else if (e.kind == PointerEventKind.move && root.drag-active) {
                    // 只在还按着的时候转发:窗口没跟着动(手动拖动)时才需要这条。
                    root.drag-move();
                }
                // Cancel 故意不处理:它就是"指针离开了标题栏"的信号,收了就脱手。
            }
            // 双击标题栏 = 放大 / 还原,Windows 的老规矩
            double-clicked => { root.toggle-maximize-requested(); }
        }

        HorizontalLayout {
            height: 100%;
            padding-left: 18px;
            // 右边给三颗窗口键留位,别让标题压到它们下面
            padding-right: 138px;
            spacing: 8px;

            // 套一层 VBox:横向布局里定高的小圆点会被顶到行顶边(见文件头那条 alignment 的说明)
            VerticalLayout {
                alignment: center;

                Rectangle {
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: accent;
                    opacity: 0.9;
                }
            }
            Text {
                text: "MC 壁纸";
                color: Glass.label-2;
                font-size: 12px;
                font-weight: 600;
                letter-spacing: 0.6px;
                vertical-alignment: center;
            }
            Text {
                text: "·";
                color: Glass.label-3;
                font-size: 12px;
                vertical-alignment: center;
            }
            Text {
                text: "生图";
                color: Glass.label-3;
                font-size: 12px;
                vertical-alignment: center;
            }

            Rectangle { horizontal-stretch: 1; }
        }

        // 右上角三颗窗口键:自右往左 = 关闭 / 放大(还原)/ 最小化
        CaptionButton {
            kind: 3;
            plate: caption-plate;
            x: parent.width - self.width;
            picked => { root.close-requested(); }
        }
        CaptionButton {
            kind: root.maximized ? 2 : 1;
            plate: caption-plate;
            x: parent.width - self.width * 2;
            picked => { root.toggle-maximize-requested(); }
        }
        CaptionButton {
            kind: 0;
            plate: caption-plate;
            x: parent.width - self.width * 3;
            picked => { root.minimize-requested(); }
        }
    }

    // ——————————————————————————————
    // 玻璃上的内容。四周 18px 内边距,离窗口边留出一圈玻璃本色当"边框";
    // 顶上那条 36px 的安全区满宽贴边、放不进这层布局,所以这里让出 54px(= 36 + 18)。
    // ——————————————————————————————
    VerticalLayout {
        width: 100%;
        height: 100%;
        padding: 18px;
        padding-top: 54px;
        spacing: 12px;

        // —— 主体:左栏历史对话 / 右栏会话 —— 
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 14px;

            // ============ 左栏:历史对话 ============
            VerticalLayout {
                width: 244px;
                spacing: 8px;

                Pill {
                    text: "+ 新建对话";
                    primary: true;
                    accent: root.accent;
                    width: 244px;
                    clicked => {
                        root.stop-rename();
                        root.view = 0;
                        root.new-conversation();
                    }
                }

                Text {
                    text: "历史对话";
                    color: Glass.label-3;
                    font-size: 11px;
                    font-weight: 600;
                    letter-spacing: 0.5px;
                }

                flick-conv := Flickable {
                    vertical-stretch: 1;
                    viewport-width: self.width;
                    // 条目定高(50px)+ 6px 间距,内容高度直接算:比问布局要稳
                    viewport-height: max(self.height, root.conversations.length * 56px - 6px);

                    conv-list := VerticalLayout {
                        width: flick-conv.viewport-width;
                        spacing: 6px;
                        alignment: start;

                        for conv[i] in root.conversations : ConversationRow {
                            heading: conv.heading;
                            sub: conv.sub;
                            pinned: conv.pinned;
                            unread: conv.unread;
                            renaming: i == root.rename-row;
                            selected: i == root.current-conversation && root.view == 0;
                            accent: root.accent;

                            picked => {
                                root.stop-rename();
                                root.view = 0;
                                root.current-conversation = i;
                                root.select-conversation(i);
                            }
                            menu-requested(x, y) => {
                                // 先收掉正在改名的行:菜单和输入框同时开着,焦点和命中测试要打架
                                root.stop-rename();
                                root.open-menu(i, conv.pinned, x, y);
                            }
                            rename-committed(text) => {
                                root.rename-row = -1;
                                root.rename-conversation(i, text);
                            }
                            rename-cancelled => { root.rename-row = -1; }
                        }
                    }
                }

                // 底部三个入口:再点一次当前项就回到会话
                NavRow {
                    text: "壁纸库";
                    active: root.view == 1;
                    accent: root.accent;
                    picked => {
                        root.stop-rename();
                        root.view = root.view == 1 ? 0 : 1;
                        // 切进库页时问一次:库目录被外面改过(手工删、拷别人的壁纸进来)也能跟上
                        if (root.view == 1) { root.refresh-library(); }
                    }
                }
                NavRow {
                    text: "设置";
                    active: root.view == 2;
                    accent: root.accent;
                    picked => {
                        root.stop-rename();
                        root.view = root.view == 2 ? 0 : 2;
                    }
                }
            }
            // ============ 右栏:会话 / 参数 / 库 / 设置 ============
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 10px;

                // 头部:会话标题(或当前视图名)
                HorizontalLayout {
                    height: 26px;
                    spacing: 10px;
                    // 不写 alignment:否则标题会跑到中间,靠右的信息也没法贴边

                    Text {
                        text: root.view == 0
                            ? root.session-title
                            : (root.view == 1 ? "壁纸库" : "设置");
                        color: Glass.label;
                        font-size: 17px;
                        vertical-alignment: center;
                    }

                    Rectangle { horizontal-stretch: 1; }

                    if root.view == 0 : Text {
                        text: "当前壁纸 · " + root.wallpaper-title;
                        color: Glass.label-3;
                        font-size: 11px;
                        vertical-alignment: center;
                        overflow: elide;
                        max-width: 280px;
                    }
                    if root.view == 1 : Text {
                        text: root.library.length + " 张";
                        color: Glass.label-3;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }

                // —— 视图 0:会话 —— 
                if root.view == 0 : VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 10px;

                    // 空态:还没有消息
                    if root.messages.length == 0 : Rectangle {
                        vertical-stretch: 1;
                        border-radius: Glass.r-card;
                        background: Glass.fill;

                        VerticalLayout {
                            alignment: center;
                            spacing: 6px;

                            Text {
                                text: "还没有开始";
                                color: Glass.label;
                                font-size: 16px;
                                font-weight: 600;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "说一句想要的样子,比如「雨夜城市,再冷一点」";
                                color: Glass.label-3;
                                font-size: 12px;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    // 消息流
                    if root.messages.length > 0 : flick-msg := Flickable {
                        vertical-stretch: 1;
                        viewport-width: self.width;
                        viewport-height: msg-list.preferred-height;

                        // —— 钉到底部:面板刚打开 / 新消息到 / 切了会话 ——
                        //
                        // `viewport-y` 是**滚动偏移,往下滚是负值**:内容比视口高时,"到底"的位置是
                        // `height - viewport-height`。写成正数会被 Flickable 自己夹回 0(它的合法区间
                        // 就是 `[height - viewport-height, 0]`,见 i-slint-core 的 `ensure_in_bound`),
                        // 表现就是"永远停在顶部,最新那条得手动滚" —— 实测踩过。
                        //
                        // 也不能只写一次:消息数组变的那一刻布局还没重算,这时候读 `viewport-height`
                        // (它绑着 `msg-list.preferred-height`)拿到的是旧值,算出来的偏移量就差一条。
                        // 而"内容高度一变就去写 viewport-y"这条更直接的路走不通 —— 那个通知正好从
                        // 布局求值中间发出来,在它里面改滚动位置会 panic(`Recursion detected`),
                        // 绕一层本地属性也一样;`init` 里直接读/写这两个属性同样踩"正在求值的属性",
                        // 一样 panic。
                        //
                        // 所以:`changed` 里先按当前(可能是旧的)高度钉一次,再让一个短命定时器在
                        // **后面几帧**里反复重钉 —— 每次重新读一遍高度,总有一次读到的是布局重算之后
                        // 的值。停的条件**只能是次数**,不能是"钉到位了没":那个判断同样会读到旧值,
                        // 于是第一次就以为自己已经到底、提前把自己停掉(实测就是这么停的)。
                        // 8 次 ≈ 0.13 s:够跨过布局,又短到来不及和用户手动滚动的动作打架。
                        //
                        // `changed` 的语法只认本元素作用域里的属性名(写不了 `root.xxx`),所以先把
                        // root 的两个信号引成本地属性,再监听它们。
                        private property <int> revision: root.message-revision;
                        private property <int> conversation: root.current-conversation;
                        private property <int> tries: 0;
                        // `init` 里**只**能启动定时器:这时候 Flickable 自己的几何还没算完,读
                        // `viewport-height` / `height` 会踩到"正在求值的属性"上,当场 panic
                        // (`Recursion detected`)—— 实测踩过。所以钉的那一下留给定时器的第一帧。
                        init => { self.start-pin(); }
                        changed revision => {
                            self.viewport-y = min(0px, self.height - self.viewport-height);
                            self.start-pin();
                        }
                        changed conversation => {
                            self.viewport-y = min(0px, self.height - self.viewport-height);
                            self.start-pin();
                        }

                        function start-pin() {
                            self.tries = 0;
                            pin.running = true;
                        }
                        pin := Timer {
                            interval: 16ms;
                            running: false;
                            triggered => {
                                flick-msg.viewport-y = min(0px, flick-msg.height - flick-msg.viewport-height);
                                flick-msg.tries += 1;
                                self.running = flick-msg.tries < 8;
                            }
                        }

                        msg-list := VerticalLayout {
                            width: flick-msg.viewport-width;
                            spacing: 10px;
                            alignment: start;

                            for msg[i] in root.messages : MessageRow {
                                body: msg.text;
                                mine: msg.mine;
                                shot: msg.shot;
                                has-shot: msg.has-shot;
                                photo-gone: msg.photo-gone;
                                accent: root.accent;
                                preview => { root.open-photo(msg.photo-id); }
                                menu-requested(x, y) => { root.open-shot-menu(i, x, y); }
                            }
                        }
                    }
                }

                // —— 视图 1:壁纸库(缩略图网格;数据由壁纸侧扫库目录灌进来)—— 
                if root.view == 1 : Rectangle {
                    vertical-stretch: 1;
                    border-radius: Glass.r-card;
                    background: Glass.fill;

                    // 每行几格:**跟着视口宽度走**,而不是写死 4 列。
                    //
                    // 原来写死 4 列 + 168px 的格子,面板拉到 1536 宽时右边空出一大片,
                    // 而且窗口放大/还原之后格子还是那么小。现在按宽度分三档,再**把剩下的
                    // 宽度平分给每格** —— 所以每一行永远是"正好铺满",不会留半格。
                    //
                    // 用三档而不是"按最小宽度算列数":后者要做浮点除法和取整,而 Slint 里
                    // 长度和整数之间的转换最容易出隐式截断的坑(算错的表现是格子错位一格)。
                    property <int> cols: flick-lib.width > 1420px
                        ? 6
                        : (flick-lib.width > 1150px ? 5 : 4);
                    property <length> cell-gap: 12px;
                    property <length> cell-w: (flick-lib.width - (cols - 1) * cell-gap) / cols;
                    // 高宽比 10:16(Slint 里没有小数长度,所以写成"乘 62 再除 100"的整数运算),
                    // 再加 26px 给底下的标题行留位置。
                    property <length> cell-h: cell-w * 62 / 100 + 26px;

                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;

                        HorizontalLayout {
                            spacing: 10px;
                            // 不写 alignment:说明文字撑开、按钮贴右边

                            Text {
                                text: "点一张就换上去;右键有更多";
                                color: Glass.label-3;
                                font-size: 11px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }

                            VerticalLayout {
                                alignment: center;
                                Pill {
                                    text: "导入图片";
                                    box-width: 92px;
                                    clicked => { root.import-wallpaper(); }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                Pill {
                                    text: "删除";
                                    box-width: 68px;
                                    ink: #FF6B60;
                                    // 库里没有"当前这张"就没得删(比如桌面壁纸还没抬进来)
                                    enabled: root.library-current-index >= 0;
                                    clicked => { root.confirm-delete = true; }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                Pill {
                                    text: "做成动态壁纸";
                                    accent: root.accent;
                                    clicked => { root.make-video-current(); }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                Pill {
                                    text: "用当前壁纸";
                                    accent: root.accent;
                                    clicked => { root.adopt-wallpaper(); }
                                }
                            }
                        }

                        // 空态和网格**共用同一个** Flickable。
                        //
                        // 为什么不是"两个 `if` 分支各自撑一个元素":布局里两个都带 `vertical-stretch`
                        // 的元素会把空白**各分一份**,实测结果是网格被压到卡片中部以下、头上空一大块
                        // (而两个分支里真正渲染的只有一个)。只留一个撑开的元素,这件事就没得猜错。
                        flick-lib := Flickable {
                            vertical-stretch: 1;
                            viewport-width: self.width;
                            viewport-height: lib-grid.height;

                            // **自己算坐标**而不是用 GridLayout:Slint 的 GridLayout 不支持 `for`
                            // (`'if' or 'for' expressions are not currently supported in grid
                            // layouts`),而列数要在运行期按库里的张数折行。
                            //
                            // 行号一律写 `Math.floor(i / cols)`,**不能直接拿 `i / cols` 当行号**:
                            // Slint 的 `/` 永远是浮点除,两个 int 相除也先抬成 float —— 编译器里
                            // 写死 `(false, false) => Type::Float32`(见 i-slint-compiler 的
                            // passes/resolving.rs),所以 `i / cols` 出来是 0.25 / 0.5 / 0.75 而不是
                            // 0。上一版就是直接拿它当行号,结果 4 张图全落在第 0 列、只差几十像素地
                            // 摞在一起(而且行数算成 1.75 行),这就是"库页排版乱"的真凶。
                            //
                            // 这里用浮点是安全的:两个 int 相除只要除得尽,结果在二进制里一定精确
                            // (1.0 / 2.0 这种),floor 不会少一;ceil 只用来把"最后一行不满"也算一行。
                            lib-grid := Rectangle {
                                width: flick-lib.viewport-width;
                                // 行数 = ⌈张数 / cols⌉;最后一行不满也按一行算。
                                // 再和视口高度取大:一张都没有时行数是 0(算出来是负的),而空态那句
                                // 说明要占满整个视口才谈得上居中。
                                height: max(
                                    flick-lib.height,
                                    Math.ceil(root.library.length / cols) * (cell-h + cell-gap) - cell-gap,
                                );

                                // 空态:一张都没有时,说清楚第一张从哪儿来
                                if root.library.length == 0 : Text {
                                    x: 0;
                                    y: 0;
                                    width: parent.width;
                                    height: parent.height;
                                    text: "库还是空的 —— 在右边对话里说一句想看到的样子,或者点上面的「导入图片」把本机图片收进来。";
                                    color: Glass.label-3;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                for item[i] in root.library : LibraryCell {
                                    // 行号 floor 出来,列号再用"序号 - 行首序号"减出来(就是上面说的
                                    // 那个浮点除的坑);乘回长度之后是正常的 length。
                                    x: (i - Math.floor(i / cols) * cols) * (cell-w + cell-gap);
                                    y: Math.floor(i / cols) * (cell-h + cell-gap);
                                    cell-w: cell-w;
                                    cell-h: cell-h;
                                    thumb: item.thumb;
                                    heading: item.title;
                                    selected: item.id == root.library-current;
                                    video: item.video;
                                    accent: item.accent;

                                    picked => { root.open-wallpaper(i); }
                                    menu-requested(x, y) => { root.open-lib-menu(i, x, y); }
                                }
                            }
                        }
                    }
                }

                // —— 视图 2:设置 —— 
                // 分两组:**对话模型**(把一句话写成提示词)和**生图模型**(拿提示词出图)。
                // 两组可以不是同一家,所以各留一套接口地址 / 模型名 / Key;生图那组留空就跟着
                // 对话那组走(见 `mcwp_ai::ImagesConfig::load`)。
                if root.view == 2 : Rectangle {
                    vertical-stretch: 1;
                    border-radius: Glass.r-card;
                    background: Glass.fill;

                    // 内容比卡片高是可预料的(两组各三行输入框),所以套一层 Flickable:
                    // 软件渲染器下溢出的部分**不是裁掉而是直接不画**,不滚动的话下面几行会静默消失。
                    set-flick := Flickable {
                        x: 18px;
                        y: 18px;
                        width: parent.width - 36px;
                        height: parent.height - 36px;
                        viewport-width: self.width;
                        viewport-height: set-col.preferred-height;

                        set-col := VerticalLayout {
                            width: set-flick.viewport-width;
                        spacing: 10px;

                        Text {
                            text: "对话模型";
                            color: Glass.label;
                            font-size: 15px;
                            font-weight: 600;
                        }
                        Text {
                            text: "把你说的一句话写成一段给生图模型的提示词。填好点保存,写进 %APPDATA%\\MC壁纸\\ai.json;下次启动自动读回来。";
                            color: Glass.label-3;
                            font-size: 11px;
                            wrap: word-wrap;
                        }

                        FieldRow {
                            label: "接口地址";
                            placeholder: "https://open.bigmodel.cn/api/paas/v4";
                            value <=> root.ai-base-url;
                            accent: root.accent;
                        }
                        FieldRow {
                            label: "模型名";
                            placeholder: "glm-4-flash-250414";
                            value <=> root.ai-model;
                            accent: root.accent;
                        }
                        FieldRow {
                            label: "API Key";
                            placeholder: "去服务商那边生成一个";
                            value <=> root.ai-key;
                            accent: root.accent;
                        }
                        ChoiceRow {
                            label: "深度思考";
                            options: ["不发", "开启", "关闭"];
                            current <=> root.ai-thinking;
                            accent: root.accent;
                        }
                        Text {
                            text: "不发 = 请求体里不带这个字段。智谱 4.7 系列默认开思考(一句话要等十几秒),换过去就选「关闭」;4 代的 glm-4-flash 没有思考模式,选「不发」。";
                            color: Glass.label-3;
                            font-size: 10px;
                            wrap: word-wrap;
                        }

                        if root.ai-env-override : Text {
                            text: "注意:有 MCWP_AI_ 开头的环境变量在生效,这里改的会被它们盖掉";
                            color: Glass.label-2;
                            font-size: 11px;
                            overflow: elide;
                        }

                        Rectangle { height: 1px; background: Glass.hairline-dim; }

                        Text {
                            text: "生图模型";
                            color: Glass.label;
                            font-size: 15px;
                            font-weight: 600;
                        }
                        Text {
                            text: "拿上面那段提示词出图。留空就跟上面那组一样(同一家时只填上面就够)。";
                            color: Glass.label-3;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        FieldRow {
                            label: "生图地址";
                            placeholder: "留空 = 跟上面的接口地址一样";
                            value <=> root.ai-image-base-url;
                            accent: root.accent;
                        }
                        FieldRow {
                            label: "生图模型名";
                            placeholder: "glm-image";
                            value <=> root.ai-image-model;
                            accent: root.accent;
                        }
                        FieldRow {
                            label: "生图 Key";
                            placeholder: "留空 = 跟上面的 API Key 一样";
                            value <=> root.ai-image-key;
                            accent: root.accent;
                        }
                        ChoiceRow {
                            label: "生图画质";
                            options: ["标准", "高清"];
                            current <=> root.ai-image-quality;
                            accent: root.accent;
                        }
                        Text {
                            text: "标准 = 服务商默认(快,但出图明显更糊);高清让模型多跑一遍细节。实测是拿 cogview-3-flash 做的(高频细节多 41%);换成 glm-image 之后这个字段照发,但效果还没验。";
                            color: Glass.label-3;
                            font-size: 10px;
                            wrap: word-wrap;
                        }
                        ChoiceRow {
                            label: "生图水印";
                            options: ["不加", "加"];
                            current <=> root.ai-image-watermark;
                            accent: root.accent;
                        }
                        Text {
                            text: "「AI生成」那枚角标是服务商盖的,不是我们画的。想不加,先在智谱「个人中心 → 安全管理 → 去水印管理」签过免责声明;没签的账号这条请求会被拒,程序会自动退回带水印再画一张,并在状态栏说明。";
                            color: Glass.label-3;
                            font-size: 10px;
                            wrap: word-wrap;
                        }
                        FieldRow {
                            label: "视频模型名";
                            placeholder: "留空 = cogvideox-3";
                            value <=> root.ai-video-model;
                            accent: root.accent;
                        }
                        Text {
                            text: "「做成动态壁纸」用的模型:拿一张图生成 5 秒左右的短视频。地址和 Key 都跟上面生图那组走;想换别的视频模型(比如 cogvideox-flash)才需要改这里。";
                            color: Glass.label-3;
                            font-size: 10px;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            // 胶囊按钮在横向布局里会贴着上沿,套一层竖直居中的布局才不歪
                            VerticalLayout {
                                alignment: center;
                                Pill {
                                    text: "保存";
                                    primary: true;
                                    accent: root.accent;
                                    clicked => {
                                        root.save-ai-config(
                                            root.ai-base-url,
                                            root.ai-model,
                                            root.ai-key,
                                            root.ai-thinking,
                                            root.ai-image-base-url,
                                            root.ai-image-model,
                                            root.ai-image-key,
                                            root.ai-image-quality,
                                            root.ai-image-watermark,
                                            root.ai-video-model
                                        );
                                    }
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        }
                    }
                }

                // —— 状态行(一次性的反馈都放这儿)—— 
                // 注意 `height` 不能压到字体行盒以下:原来写 14px 配 11px 的字,软件渲染器会把
                // 整行裁掉(**不是截断,是一个像素都不画**),状态文字于是静默消失 —— 实测踩过。
                Text {
                    text: root.status;
                    color: Glass.label-3;
                    font-size: 11px;
                    height: 20px;
                    vertical-alignment: center;
                    overflow: elide;
                }

                // —— 底栏:会话是输入框,参数是操作按钮 —— 
                if root.view == 0 : Rectangle {
                    height: 46px;
                    border-radius: self.height / 2;
                    // 实色凹槽 + 发丝线,和滑杆轨道同一套语言
                    background: #0000003D;
                    border-width: 1px;
                    border-color: input.has-focus ? root.accent.with-alpha(0.65) : Glass.hairline-dim;
                    animate border-color { duration: 140ms; easing: ease-out; }

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 6px;
                        spacing: 8px;
                        // 不写 alignment:写了输入框会塌成文字那么宽并居中

                        input := TextInput {
                            horizontal-stretch: 1;
                            font-size: 13px;
                            color: Glass.label;
                            vertical-alignment: center;
                            text <=> root.draft;
                            accepted => { root.submit(); }
                        }

                        // 发送 / 暂停 / 继续三态共用**同一个 76px 宽的格子**:宽度写死,切状态时
                        // 输入框不会跟着抖一下。三颗钮竖直居中(横向布局里它们会贴着上沿,见文件
                        // 顶部的布局说明)。
                        VerticalLayout {
                            alignment: center;

                            HorizontalLayout {
                                width: 76px;

                                if root.run-state == 1 : HorizontalLayout {
                                    alignment: end;
                                    RunButton {
                                        clicked => { root.pause-run(); }
                                    }
                                }

                                // 暂停之后:输入框空着就是「继续」(接着跑刚才那句),一旦开始
                                // 打字就变回「发送」—— 用户敲了新东西,意思就是这一句别管了,跑新的。
                                if root.run-state == 2 && root.draft == "" : HorizontalLayout {
                                    alignment: end;
                                    Pill {
                                        text: "继续";
                                        primary: true;
                                        accent: root.accent;
                                        width: 76px;
                                        clicked => { root.resume-run(); }
                                    }
                                }

                                if root.run-state == 0 || (root.run-state == 2 && root.draft != "") : HorizontalLayout {
                                    alignment: end;
                                    Pill {
                                        text: "发送";
                                        primary: true;
                                        accent: root.accent;
                                        width: 76px;
                                        clicked => { root.submit(); }
                                    }
                                }
                            }
                        }
                    }

                    // 占位文案:TextInput 没有 placeholder 属性,拿一条绝对定位的 Text 盖上
                    Text {
                        x: 15px;
                        y: (parent.height - self.height) / 2;
                        text: "说一句想看到的样子…";
                        color: Glass.label-3;
                        font-size: 13px;
                        visible: root.draft == "";
                    }
                }

            }
        }
    }

    // ——————————————————————————————
    // 会话的右键菜单浮层。**最后声明** = 盖在所有东西之上:菜单开着的时候,连顶部那三颗
    // 窗口键也点不到(点一下先关菜单),和系统菜单的行为一致。
    // ——————————————————————————————
    if root.menu-row >= 0 : Rectangle {
        // 铺满整窗。Window 的孩子不带 x / y 会被居中摆,这里显式钉在左上角(见文件头)。
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;

        // 点菜单以外的地方就收掉。它铺满整窗,菜单声明在它后面 —— 后声明的浮在上面,
        // 所以照旧是"点菜单里的项 → 那一项;点别处 → 关菜单"。
        dismiss := TouchArea {
            clicked => { root.close-menu(); }
        }

        ConversationMenu {
            x: root.menu-x;
            y: root.menu-y;
            pinned: root.menu-pinned;
            plate: root.caption-plate.brighter(0.06);

            rename-picked => {
                // 先开输入框、再收菜单:顺序反过来的话 `menu-row` 已经归 -1,拿不到行号了
                root.rename-row = root.menu-row;
                root.close-menu();
            }
            pin-picked => {
                root.toggle-pin-conversation(root.menu-row);
                root.close-menu();
            }
            unread-picked => {
                root.mark-conversation-unread(root.menu-row);
                root.close-menu();
            }
            delete-picked => {
                root.delete-conversation(root.menu-row);
                root.close-menu();
            }
        }
    }

    // 壁纸库那一格的右键菜单浮层。和会话菜单同一个规矩:最后声明 = 盖在所有东西之上。
    // 两条都带 `view` 判断:菜单是根级浮层,不带上它就会在切页之后继续压在新页面上。
    if root.lib-menu-row >= 0 && root.view == 1 : Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;

        dismiss-lib := TouchArea {
            clicked => { root.close-lib-menu(); }
        }

        LibraryMenu {
            x: root.menu-x;
            y: root.menu-y;
            plate: root.caption-plate.brighter(0.06);
            is-video: root.lib-menu-video;

            apply-picked => {
                root.open-wallpaper(root.lib-menu-row);
                root.close-lib-menu();
            }
            animate-picked => {
                root.make-video(root.lib-menu-row);
                root.close-lib-menu();
            }
            delete-picked => {
                root.delete-wallpaper(root.lib-menu-row);
                root.close-lib-menu();
            }
        }
    }

    // 消息预览图的右键菜单。规矩同上(最后声明 = 盖在最上面)。
    if root.shot-menu-photo != "" && root.view == 0 : Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;

        dismiss-shot := TouchArea {
            clicked => { root.close-shot-menu(); }
        }

        ShotMenu {
            x: root.menu-x;
            y: root.menu-y;
            plate: root.caption-plate.brighter(0.06);

            view-picked => {
                root.open-photo(root.shot-menu-photo);
                root.close-shot-menu();
            }
            apply-picked => {
                root.set-as-wallpaper(root.shot-menu-photo);
                root.close-shot-menu();
            }
        }
    }

    // 「删除」的二次确认。**只挡工具栏那颗钮**:右键菜单里点「删除这一张」,菜单本身就是
    // 那一刻的意图表达(还得多点一次才叫确认就太啰嗦了)。
    //
    // 删壁纸是不可逆的(文件直接删掉,没有回收站那一步),所以这条路上问一句。
    if root.confirm-delete : Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;

        // 点外面(不点按钮)当取消 —— 和系统弹窗一个习惯
        back := TouchArea {
            clicked => { root.confirm-delete = false; }
        }

        card := Rectangle {
            width: 340px;
            height: 168px;
            // 水平居中:面板根是 Window,`parent.width` 就是窗口宽度
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: Glass.r-card;
            border-width: 1px;
            border-color: Glass.hairline;
            background: root.caption-plate.brighter(0.06);

            VerticalLayout {
                padding: 18px;
                spacing: 10px;

                Text {
                    text: "从壁纸库里删掉这张?";
                    color: Glass.label;
                    font-size: 14px;
                    font-weight: 600;
                }

                Text {
                    text: root.library-current-title + "\n删掉之后只能重新生成或导入,文件不会进回收站。";
                    color: Glass.label-2;
                    font-size: 12px;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }

                HorizontalLayout {
                    spacing: 10px;
                    Rectangle { horizontal-stretch: 1; }
                    Pill {
                        text: "取消";
                        box-width: 88px;
                        clicked => { root.confirm-delete = false; }
                    }
                    Pill {
                        text: "删除";
                        box-width: 88px;
                        ink: #FF6B60;
                        clicked => {
                            root.confirm-delete = false;
                            root.delete-wallpaper(root.library-current-index);
                        }
                    }
                }
            }
        }
    }

    // 看大图。**最后声明** = 盖在确认框和两个菜单之上(它是最"上面"的那一层)。
    if root.viewing : Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        // 半透明深色遮罩。窗口本身不是透明的(见文件头),所以这里是"盖住"而不是"透出桌面"。
        background: root.caption-plate.darker(0.55).with-alpha(0.94);

        Image {
            x: 28px;
            y: 24px;
            width: parent.width - 56px;
            height: parent.height - 84px;
            source: root.viewer;
            image-fit: contain;
        }

        Text {
            x: 28px;
            y: parent.height - 52px;
            width: parent.width - 56px;
            height: 24px;
            text: root.viewer-title + " · 点任意处关闭";
            color: Glass.label-2;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        // 遮罩本身当"关闭"的命中区。图片没有 TouchArea,所以点在图上也会落到这里。
        dismiss-view := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.viewing = false;
                root.viewer-closed();
            }
        }
    }
}
